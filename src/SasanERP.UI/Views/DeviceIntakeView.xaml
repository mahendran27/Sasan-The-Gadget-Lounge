<UserControl x:Class="SasanERP.UI.Views.DeviceIntakeView"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
              xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
              mc:Ignorable="d" 
              d:DesignHeight="700" d:DesignWidth="1100">

    <Grid Margin="16,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="{DynamicResource SasanCardBgBrush}" BorderBrush="{DynamicResource SasanBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="NEW PRODUCT INTAKE, BUYBACK &amp; BARCODE STICKER STUDIO" FontWeight="Black" FontSize="16" Foreground="{DynamicResource SasanCyanAccentBrush}"/>
                    <TextBlock Text="Intake smartphones, MacBooks, drones, audio, evaluate battery health %, and print custom stickers" FontSize="11" Foreground="{DynamicResource SasanSubTextBrush}" Margin="0,2,0,0"/>
                </StackPanel>
                <Border Grid.Column="1" Background="{DynamicResource SasanHeaderBgBrush}" CornerRadius="6" Padding="10,4" VerticalAlignment="Center">
                    <TextBlock Text="SASAN THE GADGET LOUNGE - THENI" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SasanAmberAccentBrush}"/>
                </Border>
            </Grid>
        </Border>

        <!-- WORKSPACE (LEFT: FORM, RIGHT: LIVE STICKER PREVIEW) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="6*" />
                <ColumnDefinition Width="4*" />
            </Grid.ColumnDefinitions>

            <!-- LEFT: INTAKE FORM -->
            <Border Grid.Column="0" Background="{DynamicResource SasanCardBgBrush}" BorderBrush="{DynamicResource SasanBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,10,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Category & Serialized Check -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Device Category:" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SasanSubTextBrush}" Margin="0,0,0,4"/>
                                <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" Height="32"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" IsChecked="{Binding IsSerialized}" Content="Track by IMEI/Serial" 
                                      FontSize="12" FontWeight="Bold" Foreground="{DynamicResource SasanCyanAccentBrush}" VerticalAlignment="Bottom" Margin="12,0,0,6"/>
                        </Grid>

                        <!-- Brand & Model Name -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="4*" />
                                <ColumnDefinition Width="6*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                <TextBlock Text="Brand:" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SasanSubTextBrush}" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding Brand, UpdateSourceTrigger=PropertyChanged}" Height="32"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                <TextBlock Text="Model Name:" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SasanSubTextBrush}" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding ModelName, UpdateSourceTrigger=PropertyChanged}" Height="32"/>
                            </StackPanel>
                        </Grid>

                        <!-- Storage & Color -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                <TextBlock Text="Storage Capacity:" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SasanSubTextBrush}" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding StorageCapacity, UpdateSourceTrigger=PropertyChanged}" Height="32"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                <TextBlock Text="Color:" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SasanSubTextBrush}" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding Color, UpdateSourceTrigger=PropertyChanged}" Height="32"/>
                            </StackPanel>
                        </Grid>

                        <!-- Primary IMEI & Auto Generate -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Primary IMEI 1 / Serial #:" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SasanSubTextBrush}" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding Imei1, UpdateSourceTrigger=PropertyChanged}" Height="32" FontWeight="Bold" Foreground="{DynamicResource SasanCyanAccentBrush}"/>
                            </StackPanel>
                            <Button Grid.Column="1" Command="{Binding GenerateRandomSampleImeiCommand}"
                                    Content="🎲 New IMEI" Height="32" Margin="8,18,0,0" Padding="10,0" Background="{DynamicResource SasanBorderBrush}" Foreground="{DynamicResource SasanForegroundBrush}" Cursor="Hand"/>
                        </Grid>

                        <!-- Secondary IMEI & Hardware Serial -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                <TextBlock Text="Secondary IMEI 2 (eSIM/Dual):" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SasanSubTextBrush}" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding Imei2, UpdateSourceTrigger=PropertyChanged}" Height="32"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                <TextBlock Text="Hardware Serial Number:" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SasanSubTextBrush}" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding SerialNumber, UpdateSourceTrigger=PropertyChanged}" Height="32"/>
                            </StackPanel>
                        </Grid>

                        <!-- Battery Health % & Physical Condition -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="4*" />
                                <ColumnDefinition Width="6*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                <TextBlock Text="Battery Health %:" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SasanSubTextBrush}" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding BatteryHealthPercentage, UpdateSourceTrigger=PropertyChanged}" Height="32"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                <TextBlock Text="Condition Grade:" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SasanSubTextBrush}" Margin="0,0,0,4"/>
                                <ComboBox ItemsSource="{Binding ConditionGrades}" SelectedItem="{Binding SelectedCondition}" Height="32"/>
                            </StackPanel>
                        </Grid>

                        <!-- Warranty & Purchase Source -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                <TextBlock Text="Warranty Coverage:" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SasanSubTextBrush}" Margin="0,0,0,4"/>
                                <ComboBox ItemsSource="{Binding WarrantyOptions}" SelectedItem="{Binding SelectedWarranty}" Height="32"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                <TextBlock Text="Intake Source:" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SasanSubTextBrush}" Margin="0,0,0,4"/>
                                <ComboBox ItemsSource="{Binding PurchaseSources}" SelectedItem="{Binding SelectedSource}" Height="32"/>
                            </StackPanel>
                        </Grid>

                        <!-- Purchase Cost & Selling Price -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                <TextBlock Text="Purchase Cost (₹):" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SasanSubTextBrush}" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding PurchaseCost, UpdateSourceTrigger=PropertyChanged}" Height="32" Foreground="{DynamicResource SasanAmberAccentBrush}" FontWeight="Bold"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                <TextBlock Text="Tagged Selling Price (₹):" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SasanCyanAccentBrush}" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding SellingPrice, UpdateSourceTrigger=PropertyChanged}" Height="32" Foreground="{DynamicResource SasanCyanAccentBrush}" FontWeight="Bold"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- RIGHT: LIVE STICKER PREVIEW & PRINT -->
            <Border Grid.Column="1" Background="{DynamicResource SasanCardBgBrush}" BorderBrush="{DynamicResource SasanBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Barcode Style Selector (Choices 1 to 7) -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="LIVE STICKER STUDIO" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource SasanCyanAccentBrush}" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🏷️ Style: " FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SasanSubTextBrush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <ComboBox ItemsSource="{Binding AvailableBarcodeStyles}" SelectedItem="{Binding SelectedBarcodeStyle}" Width="190" Height="28" FontSize="11"/>
                        </StackPanel>
                    </Grid>

                    <!-- THE PHYSICAL STICKER SIMULATION -->
                    <StackPanel Grid.Row="1" VerticalAlignment="Center">
                        <!-- Style Badge -->
                        <Border Background="{DynamicResource SasanHeaderBgBrush}" BorderBrush="{DynamicResource SasanBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,0,8" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding StickerBadgeText}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource SasanAmberAccentBrush}"/>
                        </Border>

                        <Border Background="{Binding StickerBackground}" BorderBrush="#000000" BorderThickness="1.5"
                                CornerRadius="{Binding StickerCornerRadius}" Padding="10"
                                HorizontalAlignment="Center" Width="{Binding StickerWidth}" Height="{Binding StickerHeight}">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="SASAN THE GADGET LOUNGE" FontSize="10" FontWeight="Black" Foreground="#000000" HorizontalAlignment="Center"/>
                                
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,0">
                                    <TextBlock Text="{Binding Brand}" FontSize="11" FontWeight="Bold" Foreground="#000000"/>
                                    <TextBlock Text="{Binding ModelName}" FontSize="11" FontWeight="Bold" Foreground="#000000" Margin="4,0,0,0"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,1,0,0">
                                    <TextBlock Text="{Binding StorageCapacity}" FontSize="9" Foreground="#333333"/>
                                    <TextBlock Text=" | " FontSize="9" Foreground="#666666"/>
                                    <TextBlock Text="{Binding Color}" FontSize="9" Foreground="#333333"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,1,0,0">
                                    <TextBlock Text="{Binding BatteryHealthPercentage, StringFormat='Bat: {0}%'}" FontSize="8" FontWeight="SemiBold" Foreground="#111111"/>
                                    <TextBlock Text=" • " FontSize="8" Foreground="#666666"/>
                                    <TextBlock Text="{Binding SelectedCondition}" FontSize="8" Foreground="#111111"/>
                                </StackPanel>

                                <!-- Barcode / QR Image Simulation -->
                                <Border Height="45" Background="Transparent" Margin="0,4,0,0" HorizontalAlignment="Center">
                                    <Image Source="{Binding PreviewBarcodeBytes}" Stretch="Uniform" Height="45"/>
                                </Border>

                                <Grid Margin="0,2,0,0">
                                    <TextBlock Text="{Binding Imei1, StringFormat='IMEI: {0}'}" FontSize="9" FontWeight="Bold" Foreground="#000000" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding SellingPrice, StringFormat='₹{0:N0}'}" FontSize="12" FontWeight="Black" Foreground="#000000" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ACTION BUTTONS -->
                    <StackPanel Grid.Row="2" Margin="0,12,0,0">
                        <Button Command="{Binding SaveAndPrintStickerCommand}"
                                Height="44" Background="{DynamicResource SasanCyanAccentBrush}" Foreground="#08101E"
                                FontSize="13" FontWeight="Black" Cursor="Hand" Margin="0,0,0,6">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🏷️ SAVE &amp; PRINT BARCODE STICKER" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding PreviewStickerPdfCommand}"
                                Height="34" Margin="0,0,0,6" Background="#1E3A8A" Foreground="#FFFFFF"
                                FontSize="11" FontWeight="Bold" Cursor="Hand" ToolTip="Open high-DPI vector PDF sticker">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="👁️ PREVIEW VECTOR STICKER PDF" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Command="{Binding PrintBarcodeStickerCommand}"
                                    Content="🖨️ Print Hardware TSPL" Height="32" Margin="0,0,4,0" Background="{DynamicResource SasanBorderBrush}" Foreground="{DynamicResource SasanForegroundBrush}" Cursor="Hand"/>
                            <Button Grid.Column="1" Command="{Binding UpdatePreviewBarcodeCommand}"
                                    Content="🔄 Refresh Barcode" Height="32" Margin="4,0,0,0" Background="{DynamicResource SasanBorderBrush}" Foreground="{DynamicResource SasanForegroundBrush}" Cursor="Hand"/>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- STATUS BAR -->
        <Border Grid.Row="2" Background="{DynamicResource SasanHeaderBgBrush}" BorderBrush="{DynamicResource SasanBorderBrush}" BorderThickness="0,1,0,0" Padding="12,6" Margin="0,10,0,0">
            <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="{DynamicResource SasanCyanAccentBrush}"/>
        </Border>
    </Grid>
</UserControl>