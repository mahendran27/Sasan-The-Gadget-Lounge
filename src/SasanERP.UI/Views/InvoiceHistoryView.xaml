<UserControl x:Class="SasanERP.UI.Views.InvoiceHistoryView"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
              xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
              mc:Ignorable="d" 
              d:DesignHeight="700" d:DesignWidth="1100">

    <Grid Margin="16,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Title & Top Bar -->
            <RowDefinition Height="Auto"/> <!-- Search & Template Selector -->
            <RowDefinition Height="*"/>    <!-- Master-Detail Split Workspace -->
            <RowDefinition Height="Auto"/> <!-- Footer Status Bar -->
        </Grid.RowDefinitions>

        <!-- 1. Header -->
        <Border Grid.Row="0" Background="{DynamicResource SasanCardBgBrush}" BorderBrush="{DynamicResource SasanBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="SALES INVOICES &amp; REPRINT HUB" FontWeight="Black" FontSize="16" Foreground="{DynamicResource SasanCyanAccentBrush}"/>
                        <Border Background="{DynamicResource SasanHeaderBgBrush}" CornerRadius="4" Padding="6,1" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="ALL PAST BILLS &amp; REPRINT" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource SasanCyanAccentBrush}"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Instant lookup by Invoice Number, Customer Phone, Name, or Device IMEI. Re-print and export vector PDFs anytime." 
                               FontSize="11" Foreground="{DynamicResource SasanSubTextBrush}" Margin="0,2,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding SearchInvoicesCommand}" Background="{DynamicResource SasanBorderBrush}" BorderThickness="0" Padding="12,6" Cursor="Hand">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔄 " FontSize="12"/>
                            <TextBlock Text="Refresh Bills" FontSize="11" Foreground="{DynamicResource SasanForegroundBrush}" FontWeight="Bold"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. Search & Template Selector Bar -->
        <Border Grid.Row="1" Background="{DynamicResource SasanCardBgBrush}" BorderBrush="{DynamicResource SasanBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Search Input -->
                <TextBox Grid.Column="0" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                         ToolTip="Search by Invoice #, Customer Phone (e.g. 9080803070), Customer Name, or Device IMEI"
                         FontSize="14" Height="36" Padding="10,6" Background="{DynamicResource SasanInputBgBrush}" Foreground="{DynamicResource SasanCyanAccentBrush}"
                         BorderBrush="{DynamicResource SasanCyanAccentBrush}" BorderThickness="1"/>

                <!-- Template Selector for Reprint -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Reprint Template:" FontSize="11.5" Foreground="{DynamicResource SasanSubTextBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox ItemsSource="{Binding AvailableTemplates}" SelectedItem="{Binding SelectedTemplate}" 
                              Width="220" Height="34" FontSize="12" FontWeight="Bold" Background="{DynamicResource SasanInputBgBrush}" Foreground="{DynamicResource SasanForegroundBrush}"/>
                </StackPanel>

                <!-- Action Buttons: Print & PDF -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                    <Button Command="{Binding ReprintInvoiceCommand}" Background="{DynamicResource SasanCyanAccentBrush}" Foreground="#08101E" 
                            FontWeight="Black" Padding="14,7" BorderThickness="0" Cursor="Hand" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🖨️ " FontSize="12"/>
                            <TextBlock Text="Re-Print Bill" FontSize="12"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding ExportPdfCommand}" Background="{DynamicResource SasanAmberAccentBrush}" Foreground="#08101E" 
                            FontWeight="Black" Padding="14,7" BorderThickness="0" Cursor="Hand" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="💾 " FontSize="12"/>
                            <TextBlock Text="Export PDF" FontSize="12"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding ShareViaWhatsAppCommand}" Background="#10B981" Foreground="#FFFFFF" 
                            FontWeight="Black" Padding="14,7" BorderThickness="0" Cursor="Hand" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="💬 " FontSize="12"/>
                            <TextBlock Text="WhatsApp" FontSize="12"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding OpenPdfPreviewCommand}" Background="#1E3A8A" Foreground="#FFFFFF" 
                            FontWeight="Bold" Padding="12,7" BorderThickness="0" Cursor="Hand">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="👁️ " FontSize="12"/>
                            <TextBlock Text="Preview" FontSize="12"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 3. Master-Detail Split Workspace -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="6*"/> <!-- Left: Invoices List -->
                <ColumnDefinition Width="4*"/> <!-- Right: Selected Invoice Detail Inspector -->
            </Grid.ColumnDefinitions>

            <!-- LEFT: Past Invoices DataGrid -->
            <Border Grid.Column="0" Background="{DynamicResource SasanCardBgBrush}" BorderBrush="{DynamicResource SasanBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="8" Margin="0,0,8,0">
                <DataGrid ItemsSource="{Binding Invoices}" SelectedItem="{Binding SelectedSummary}"
                          AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                          Background="Transparent" BorderThickness="0" HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource SasanBorderBrush}"
                          Foreground="{DynamicResource SasanForegroundBrush}" RowHeight="36"
                          EnableRowVirtualization="True" EnableColumnVirtualization="True"
                          VirtualizingStackPanel.IsVirtualizing="True"
                          VirtualizingStackPanel.VirtualizationMode="Recycling"
                          AlternatingRowBackground="{DynamicResource SasanPrimaryBrush}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="INVOICE #" Binding="{Binding InvoiceNumber}" FontWeight="Black" Foreground="{DynamicResource SasanCyanAccentBrush}" Width="130"/>
                        <DataGridTextColumn Header="DATE" Binding="{Binding InvoiceDate, StringFormat='{}{0:dd-MMM-yy hh:mm tt}'}" Width="125"/>
                        <DataGridTextColumn Header="CUSTOMER" Binding="{Binding CustomerName}" FontWeight="Bold" Width="130"/>
                        <DataGridTextColumn Header="PHONE" Binding="{Binding CustomerPhone}" Width="95"/>
                        <DataGridTextColumn Header="ITEMS" Binding="{Binding ItemCount, StringFormat='{}{0} items'}" Width="65"/>
                        <DataGridTextColumn Header="TOTAL (₹)" Binding="{Binding GrandTotal, StringFormat='₹{0:N0}'}" FontWeight="Black" Foreground="{DynamicResource SasanAmberAccentBrush}" Width="85"/>
                        <DataGridTextColumn Header="PAYMENT MODES" Binding="{Binding PaymentModes}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- RIGHT: Invoice Detail Inspector Card -->
            <Border Grid.Column="1" Background="{DynamicResource SasanCardBgBrush}" BorderBrush="{DynamicResource SasanBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="8,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Invoice Header & Status Badge -->
                        <Grid Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="SELECTED INVOICE DETAILS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SasanSubTextBrush}"/>
                                <TextBlock Text="{Binding SelectedInvoiceDetails.InvoiceNumber, FallbackValue='Select an invoice'}" 
                                           FontSize="18" FontWeight="Black" Foreground="{DynamicResource SasanCyanAccentBrush}" Margin="0,2,0,0"/>
                                <TextBlock Text="{Binding SelectedInvoiceDetails.InvoiceDate, StringFormat='{}{0:dd-MMMM-yyyy | hh:mm tt}', FallbackValue=''}" 
                                           FontSize="11" Foreground="{DynamicResource SasanSubTextBrush}"/>
                            </StackPanel>
                        </Grid>

                        <Separator Background="{DynamicResource SasanBorderBrush}" Margin="0,4,0,10"/>

                        <!-- Customer Info Card -->
                        <Border Background="{DynamicResource SasanHeaderBgBrush}" BorderBrush="{DynamicResource SasanBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="CUSTOMER &amp; TAX MANDATE" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource SasanCyanAccentBrush}" Margin="0,0,0,4"/>
                                <Grid Margin="0,2">
                                    <TextBlock Text="Name:" FontSize="11" Foreground="{DynamicResource SasanSubTextBrush}"/>
                                    <TextBlock Text="{Binding SelectedInvoiceDetails.Customer.FullName, FallbackValue='N/A'}" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource SasanForegroundBrush}" HorizontalAlignment="Right"/>
                                </Grid>
                                <Grid Margin="0,2">
                                    <TextBlock Text="Phone:" FontSize="11" Foreground="{DynamicResource SasanSubTextBrush}"/>
                                    <TextBlock Text="{Binding SelectedInvoiceDetails.Customer.PhoneNumber, FallbackValue='N/A'}" FontSize="11" Foreground="{DynamicResource SasanCyanAccentBrush}" HorizontalAlignment="Right"/>
                                </Grid>
                                <Grid Margin="0,2">
                                    <TextBlock Text="GSTIN:" FontSize="11" Foreground="{DynamicResource SasanSubTextBrush}"/>
                                    <TextBlock Text="{Binding SelectedInvoiceDetails.Customer.GSTIN, FallbackValue='Consumer'}" FontSize="11" Foreground="{DynamicResource SasanSubTextBrush}" HorizontalAlignment="Right"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Items & IMEI List -->
                        <TextBlock Text="PURCHASED GADGETS &amp; SERIAL NUMBERS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SasanAmberAccentBrush}" Margin="0,4,0,6"/>
                        <ItemsControl ItemsSource="{Binding SelectedInvoiceDetails.Items}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource SasanPrimaryBrush}" BorderBrush="{DynamicResource SasanBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding ItemDescription}" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource SasanForegroundBrush}"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                    <TextBlock Text="IMEI 1: " FontSize="10" Foreground="{DynamicResource SasanSubTextBrush}"/>
                                                    <TextBlock Text="{Binding IMEI1, FallbackValue='N/A'}" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource SasanCyanAccentBrush}" Margin="0,0,8,0"/>
                                                    <TextBlock Text="Grade: " FontSize="10" Foreground="{DynamicResource SasanSubTextBrush}"/>
                                                    <TextBlock Text="{Binding ConditionGrade, FallbackValue='New'}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource SasanAmberAccentBrush}"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding LineTotal, StringFormat='₹{0:N2}'}" FontWeight="Black" FontSize="13" Foreground="{DynamicResource SasanCyanAccentBrush}" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Financial Ledger Breakdown -->
                        <Border Background="{DynamicResource SasanHeaderBgBrush}" BorderBrush="{DynamicResource SasanBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,10,0,0">
                            <StackPanel>
                                <TextBlock Text="PAYMENT &amp; TAX SUMMARY" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource SasanCyanAccentBrush}" Margin="0,0,0,6"/>
                                <Grid Margin="0,2">
                                    <TextBlock Text="Standard Taxable Value:" FontSize="11" Foreground="{DynamicResource SasanSubTextBrush}"/>
                                    <TextBlock Text="{Binding SelectedInvoiceDetails.StandardTaxableValue, StringFormat='₹{0:N2}'}" FontSize="11" Foreground="{DynamicResource SasanForegroundBrush}" HorizontalAlignment="Right"/>
                                </Grid>
                                <Grid Margin="0,2">
                                    <TextBlock Text="CGST + SGST Output Tax:" FontSize="11" Foreground="{DynamicResource SasanSubTextBrush}"/>
                                    <TextBlock Text="{Binding SelectedInvoiceDetails.TotalCGST, StringFormat='₹{0:N2}'}" FontSize="11" Foreground="{DynamicResource SasanForegroundBrush}" HorizontalAlignment="Right"/>
                                </Grid>
                                <Grid Margin="0,2">
                                    <TextBlock Text="Rule 32(5) Margin Tax:" FontSize="11" Foreground="{DynamicResource SasanSubTextBrush}"/>
                                    <TextBlock Text="{Binding SelectedInvoiceDetails.TotalMarginTax, StringFormat='₹{0:N2}'}" FontSize="11" Foreground="{DynamicResource SasanAmberAccentBrush}" HorizontalAlignment="Right"/>
                                </Grid>
                                <Separator Background="{DynamicResource SasanBorderBrush}" Margin="0,4"/>
                                <Grid Margin="0,2">
                                    <TextBlock Text="GRAND TOTAL:" FontSize="13" FontWeight="Black" Foreground="{DynamicResource SasanForegroundBrush}"/>
                                    <TextBlock Text="{Binding SelectedInvoiceDetails.GrandTotal, StringFormat='₹{0:N2}'}" FontSize="16" FontWeight="Black" Foreground="{DynamicResource SasanCyanAccentBrush}" HorizontalAlignment="Right"/>
                                </Grid>
                                <Grid Margin="0,2">
                                    <TextBlock Text="Amount Paid:" FontSize="11" Foreground="#4ADE80"/>
                                    <TextBlock Text="{Binding SelectedInvoiceDetails.AmountPaid, StringFormat='₹{0:N2}'}" FontSize="11" FontWeight="Bold" Foreground="#4ADE80" HorizontalAlignment="Right"/>
                                </Grid>
                                <Grid Margin="0,2">
                                    <TextBlock Text="Balance Due:" FontSize="11" Foreground="#F87171"/>
                                    <TextBlock Text="{Binding SelectedInvoiceDetails.BalanceDue, StringFormat='₹{0:N2}'}" FontSize="11" FontWeight="Bold" Foreground="#F87171" HorizontalAlignment="Right"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- 4. Status Bar -->
        <Border Grid.Row="3" Background="{DynamicResource SasanHeaderBgBrush}" BorderBrush="{DynamicResource SasanBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,10,0,0">
            <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="{DynamicResource SasanSubTextBrush}" VerticalAlignment="Center"/>
        </Border>
    </Grid>
</UserControl>