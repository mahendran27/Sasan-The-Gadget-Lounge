<ui:FluentWindow x:Class="SasanERP.UI.Views.InventoryIntakeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:vm="clr-namespace:SasanERP.UI.ViewModels"
        Title="Product Intake &amp; Barcode Sticker Studio - Sasan The Gadget Lounge"
        Height="700" Width="1050"
        WindowStartupLocation="CenterOwner"
        Background="#0E1626"
        Foreground="#E0E6ED">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="#132035" BorderBrush="#223656" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="NEW PRODUCT INTAKE &amp; BARCODE STICKER STUDIO" FontWeight="Black" FontSize="16" Foreground="#00E5FF"/>
                    <TextBlock Text="Add new mobiles, MacBooks, drones, or accessories and generate custom barcode stickers" FontSize="11" Foreground="#8FA3BF" Margin="0,2,0,0"/>
                </StackPanel>
                <Border Grid.Column="1" Background="#16253D" CornerRadius="6" Padding="10,4" VerticalAlignment="Center">
                    <TextBlock Text="SASAN THE GADGET LOUNGE - THENI" FontSize="11" FontWeight="Bold" Foreground="#FF9100"/>
                </Border>
            </Grid>
        </Border>

        <!-- WORKSPACE (LEFT: FORM, RIGHT: LIVE STICKER PREVIEW) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="6*" />
                <ColumnDefinition Width="4*" />
            </Grid.ColumnDefinitions>

            <!-- LEFT: INTAKE FORM -->
            <Border Grid.Column="0" Background="#132035" BorderBrush="#223656" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,10,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Category & Serialized Check -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Device Category:" FontSize="11" FontWeight="SemiBold" Foreground="#8FA3BF" Margin="0,0,0,4"/>
                                <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" Height="32"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" IsChecked="{Binding IsSerialized}" Content="Track by IMEI/Serial" 
                                      FontSize="12" FontWeight="Bold" Foreground="#00E5FF" VerticalAlignment="Bottom" Margin="12,0,0,6"/>
                        </Grid>

                        <!-- Brand & Model Name -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="4*" />
                                <ColumnDefinition Width="6*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                <TextBlock Text="Brand:" FontSize="11" FontWeight="SemiBold" Foreground="#8FA3BF" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding Brand, UpdateSourceTrigger=PropertyChanged}" Height="32"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                <TextBlock Text="Model Name:" FontSize="11" FontWeight="SemiBold" Foreground="#8FA3BF" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding ModelName, UpdateSourceTrigger=PropertyChanged}" Height="32"/>
                            </StackPanel>
                        </Grid>

                        <!-- Storage & Color -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                <TextBlock Text="Storage Capacity:" FontSize="11" FontWeight="SemiBold" Foreground="#8FA3BF" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding StorageCapacity, UpdateSourceTrigger=PropertyChanged}" Height="32"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                <TextBlock Text="Color:" FontSize="11" FontWeight="SemiBold" Foreground="#8FA3BF" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding Color, UpdateSourceTrigger=PropertyChanged}" Height="32"/>
                            </StackPanel>
                        </Grid>

                        <!-- Primary IMEI & Auto Generate -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Primary IMEI 1 / Serial #:" FontSize="11" FontWeight="SemiBold" Foreground="#8FA3BF" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding Imei1, UpdateSourceTrigger=PropertyChanged}" Height="32" FontWeight="Bold" Foreground="#00E5FF"/>
                            </StackPanel>
                            <Button Grid.Column="1" Command="{Binding GenerateRandomSampleImeiCommand}"
                                    Content="🎲 New IMEI" Height="32" Margin="8,18,0,0" Padding="10,0" Background="#243859" Foreground="#C8D4E6"/>
                        </Grid>

                        <!-- Secondary IMEI & Hardware Serial -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                <TextBlock Text="Secondary IMEI 2 (eSIM/Dual):" FontSize="11" FontWeight="SemiBold" Foreground="#8FA3BF" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding Imei2, UpdateSourceTrigger=PropertyChanged}" Height="32"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                <TextBlock Text="Hardware Serial Number:" FontSize="11" FontWeight="SemiBold" Foreground="#8FA3BF" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding SerialNumber, UpdateSourceTrigger=PropertyChanged}" Height="32"/>
                            </StackPanel>
                        </Grid>

                        <!-- Battery Health % & Physical Condition -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="4*" />
                                <ColumnDefinition Width="6*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                <TextBlock Text="Battery Health %:" FontSize="11" FontWeight="SemiBold" Foreground="#8FA3BF" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding BatteryHealthPercentage, UpdateSourceTrigger=PropertyChanged}" Height="32"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                <TextBlock Text="Condition Grade:" FontSize="11" FontWeight="SemiBold" Foreground="#8FA3BF" Margin="0,0,0,4"/>
                                <ComboBox ItemsSource="{Binding ConditionGrades}" SelectedItem="{Binding SelectedCondition}" Height="32"/>
                            </StackPanel>
                        </Grid>

                        <!-- Warranty & Purchase Source -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                <TextBlock Text="Warranty Coverage:" FontSize="11" FontWeight="SemiBold" Foreground="#8FA3BF" Margin="0,0,0,4"/>
                                <ComboBox ItemsSource="{Binding WarrantyOptions}" SelectedItem="{Binding SelectedWarranty}" Height="32"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                <TextBlock Text="Intake Source:" FontSize="11" FontWeight="SemiBold" Foreground="#8FA3BF" Margin="0,0,0,4"/>
                                <ComboBox ItemsSource="{Binding PurchaseSources}" SelectedItem="{Binding SelectedSource}" Height="32"/>
                            </StackPanel>
                        </Grid>

                        <!-- Purchase Cost & Selling Price -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                <TextBlock Text="Purchase Cost (₹):" FontSize="11" FontWeight="SemiBold" Foreground="#8FA3BF" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding PurchaseCost, UpdateSourceTrigger=PropertyChanged}" Height="32" Foreground="#FF9100" FontWeight="Bold"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                <TextBlock Text="Tagged Selling Price (₹):" FontSize="11" FontWeight="SemiBold" Foreground="#8FA3BF" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding SellingPrice, UpdateSourceTrigger=PropertyChanged}" Height="32" Foreground="#00E5FF" FontWeight="Bold"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- RIGHT: LIVE STICKER PREVIEW & PRINT -->
            <Border Grid.Column="1" Background="#132035" BorderBrush="#223656" BorderThickness="1" CornerRadius="8" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="LIVE BARCODE STICKER PREVIEW (50x30mm)" FontWeight="Bold" FontSize="12" Foreground="#7A93B2" Margin="0,0,0,10"/>

                    <!-- THE PHYSICAL STICKER SIMULATION -->
                    <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#000000" BorderThickness="1.5" CornerRadius="4" Padding="10" Margin="10,0" VerticalAlignment="Center" Height="220">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="SASAN THE GADGET LOUNGE" FontSize="11" FontWeight="Black" Foreground="#000000" HorizontalAlignment="Center"/>
                            
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,3,0,0">
                                <TextBlock Text="{Binding Brand}" FontSize="12" FontWeight="Bold" Foreground="#000000"/>
                                <TextBlock Text="{Binding ModelName}" FontSize="12" FontWeight="Bold" Foreground="#000000" Margin="4,0,0,0"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,0">
                                <TextBlock Text="{Binding StorageCapacity}" FontSize="10" Foreground="#333333"/>
                                <TextBlock Text=" | " FontSize="10" Foreground="#666666"/>
                                <TextBlock Text="{Binding Color}" FontSize="10" Foreground="#333333"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,0">
                                <TextBlock Text="{Binding BatteryHealthPercentage, StringFormat='Bat: {0}%'}" FontSize="9" FontWeight="SemiBold" Foreground="#111111"/>
                                <TextBlock Text=" • " FontSize="9" Foreground="#666666"/>
                                <TextBlock Text="{Binding SelectedCondition}" FontSize="9" Foreground="#111111"/>
                            </StackPanel>

                            <!-- Barcode Image Simulation -->
                            <Border Height="45" Background="#FFFFFF" Margin="0,6,0,0" HorizontalAlignment="Center">
                                <Image Source="{Binding PreviewBarcodeBytes}" Stretch="Uniform" Height="45"/>
                            </Border>

                            <Grid Margin="0,4,0,0">
                                <TextBlock Text="{Binding Imei1, StringFormat='IMEI: {0}'}" FontSize="10" FontWeight="Bold" Foreground="#000000" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding SellingPrice, StringFormat='₹{0:N0}'}" FontSize="14" FontWeight="Black" Foreground="#000000" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- ACTION BUTTONS -->
                    <StackPanel Grid.Row="2" Margin="0,14,0,0">
                        <Button Command="{Binding SaveAndPrintStickerCommand}"
                                Height="48" Background="#00E5FF" Foreground="#08101E"
                                FontSize="14" FontWeight="Black" Cursor="Hand" Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🏷️ SAVE &amp; PRINT BARCODE STICKER" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Command="{Binding PrintBarcodeStickerCommand}"
                                    Content="🖨️ Print Sticker Only" Height="34" Margin="0,0,4,0" Background="#243859" Foreground="#FFFFFF"/>
                            <Button Grid.Column="1" Command="{Binding UpdatePreviewBarcodeCommand}"
                                    Content="🔄 Refresh Barcode" Height="34" Margin="4,0,0,0" Background="#243859" Foreground="#FFFFFF"/>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- STATUS BAR -->
        <Border Grid.Row="2" Background="#070E1A" BorderBrush="#1C2D4A" BorderThickness="0,1,0,0" Padding="12,6" Margin="0,10,0,0">
            <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="#00E5FF"/>
        </Border>
    </Grid>
</ui:FluentWindow>
