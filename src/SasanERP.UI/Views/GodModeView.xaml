<UserControl x:Class="SasanERP.UI.Views.GodModeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" 
             d:DesignHeight="750" d:DesignWidth="1100">

    <Grid Margin="16,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="*"/>    <!-- Tabbed Workspace -->
            <RowDefinition Height="Auto"/> <!-- Status Bar -->
        </Grid.RowDefinitions>

        <!-- 1. Header -->
        <Border Grid.Row="0" Background="{DynamicResource SasanCardBgBrush}" BorderBrush="{DynamicResource SasanBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="👑 GOD MODE: ADMINISTRATIVE CONTROL &amp; BI ANALYTICS" FontWeight="Black" FontSize="16" Foreground="{DynamicResource SasanAmberAccentBrush}"/>
                        <Border Background="{DynamicResource SasanHeaderBgBrush}" BorderBrush="{DynamicResource SasanAmberAccentBrush}" BorderThickness="1" CornerRadius="4" Padding="6,1" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="MASTER OVERRIDE ACTIVE" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource SasanAmberAccentBrush}"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Complete in-place editing of Invoices, Customers, IMEI Stock, hourly/daily Shift Analytics, and Vector PDF Reports" 
                               FontSize="11" Foreground="{DynamicResource SasanSubTextBrush}" Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. Master Tabs -->
        <TabControl Grid.Row="1" Background="{DynamicResource SasanCardBgBrush}" BorderBrush="{DynamicResource SasanBorderBrush}">

            <!-- ========================================================================= -->
            <!-- TAB 1: PERIOD & SHIFT BUSINESS INTELLIGENCE                               -->
            <!-- ========================================================================= -->
            <TabItem Header="⏱️ Shift &amp; Period Analytics">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Presets & Time Filters -->
                        <RowDefinition Height="Auto"/> <!-- Summary Cards -->
                        <RowDefinition Height="*"/>    <!-- Split Details -->
                    </Grid.RowDefinitions>

                    <!-- Row 0: Filter Controls & Presets -->
                    <Border Grid.Row="0" Background="#162544" BorderBrush="#22365D" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Presets -->
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="Quick Presets:" FontSize="11" FontWeight="Bold" Foreground="#8EA4C1" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <Button Command="{Binding QuickPresetCommand}" CommandParameter="Today" Content="Today" Height="26" Padding="8,2" Margin="0,0,6,0" Background="#1E293B" Foreground="#FFFFFF"/>
                                <Button Command="{Binding QuickPresetCommand}" CommandParameter="MorningShift" Content="Morning (9am-2pm)" Height="26" Padding="8,2" Margin="0,0,6,0" Background="#1E293B" Foreground="#00E5FF"/>
                                <Button Command="{Binding QuickPresetCommand}" CommandParameter="EveningShift" Content="Evening (2pm-10pm)" Height="26" Padding="8,2" Margin="0,0,6,0" Background="#1E293B" Foreground="#FF9100"/>
                                <Button Command="{Binding QuickPresetCommand}" CommandParameter="ThisWeek" Content="This Week" Height="26" Padding="8,2" Margin="0,0,6,0" Background="#1E293B" Foreground="#FFFFFF"/>
                                <Button Command="{Binding QuickPresetCommand}" CommandParameter="ThisMonth" Content="This Month" Height="26" Padding="8,2" Margin="0,0,6,0" Background="#1E293B" Foreground="#FFFFFF"/>
                            </StackPanel>

                            <!-- Custom Date & Time Inputs -->
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Text="From:" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <DatePicker SelectedDate="{Binding FromDate}" Width="115" Height="28"/>
                                    <TextBox Text="{Binding FromTime, UpdateSourceTrigger=PropertyChanged}" Width="55" Height="28" Margin="4,0,0,0" ToolTip="Time format HH:mm"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Text="To:" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <DatePicker SelectedDate="{Binding ToDate}" Width="115" Height="28"/>
                                    <TextBox Text="{Binding ToTime, UpdateSourceTrigger=PropertyChanged}" Width="55" Height="28" Margin="4,0,0,0" ToolTip="Time format HH:mm"/>
                                </StackPanel>

                                <Button Grid.Column="2" Command="{Binding GenerateReportCommand}" Content="⚡ Compute" Height="28" Padding="12,2" 
                                        Background="#00E5FF" Foreground="#08101E" FontWeight="Black" Cursor="Hand" Margin="0,0,8,0"/>

                                <Button Grid.Column="5" Command="{Binding ExportPdfReportCommand}" Height="30" Padding="14,2" 
                                        Background="#FFD700" Foreground="#08101E" FontWeight="Black" Cursor="Hand">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📄 " FontSize="12"/>
                                        <TextBlock Text="Export Vector PDF Report" FontSize="11.5"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Row 1: KPI Summary Cards -->
                    <Grid Grid.Row="1" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="#162544" BorderBrush="#22365D" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,3,0">
                            <StackPanel>
                                <TextBlock Text="GROSS SALES" FontSize="9" FontWeight="Bold" Foreground="#8EA4C1"/>
                                <TextBlock Text="{Binding CurrentReport.TotalGrossSales, StringFormat='₹{0:N0}'}" FontSize="15" FontWeight="Black" Foreground="#FFFFFF" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Background="#162544" BorderBrush="#0284C7" BorderThickness="1" CornerRadius="6" Padding="8" Margin="3,0,3,0">
                            <StackPanel>
                                <TextBlock Text="NET REVENUE" FontSize="9" FontWeight="Bold" Foreground="#00E5FF"/>
                                <TextBlock Text="{Binding CurrentReport.TotalNetRevenue, StringFormat='₹{0:N0}'}" FontSize="15" FontWeight="Black" Foreground="#00E5FF" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Background="#162544" BorderBrush="#22365D" BorderThickness="1" CornerRadius="6" Padding="8" Margin="3,0,3,0">
                            <StackPanel>
                                <TextBlock Text="SALES PROFIT" FontSize="9" FontWeight="Bold" Foreground="#8EA4C1"/>
                                <TextBlock Text="{Binding CurrentReport.TotalProfitEstimated, StringFormat='₹{0:N0}'}" FontSize="15" FontWeight="Black" Foreground="#4ADE80" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="3" Background="#26161B" BorderBrush="#EF4444" BorderThickness="1" CornerRadius="6" Padding="8" Margin="3,0,3,0">
                            <StackPanel>
                                <TextBlock Text="STORE EXPENSES" FontSize="9" FontWeight="Bold" Foreground="#F87171"/>
                                <TextBlock Text="{Binding CurrentReport.TotalOperatingExpenses, StringFormat='₹{0:N0}'}" FontSize="15" FontWeight="Black" Foreground="#F87171" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="4" Background="#11291F" BorderBrush="#10B981" BorderThickness="1" CornerRadius="6" Padding="8" Margin="3,0,3,0">
                            <StackPanel>
                                <TextBlock Text="TRUE NET PROFIT" FontSize="9" FontWeight="Black" Foreground="#34D399"/>
                                <TextBlock Text="{Binding CurrentReport.TrueNetBusinessProfit, StringFormat='₹{0:N0}'}" FontSize="16" FontWeight="Black" Foreground="#34D399" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="5" Background="#162544" BorderBrush="#22365D" BorderThickness="1" CornerRadius="6" Padding="8" Margin="3,0,0,0">
                            <StackPanel>
                                <TextBlock Text="STOCK IN HAND" FontSize="9" FontWeight="Bold" Foreground="#8EA4C1"/>
                                <TextBlock Text="{Binding CurrentReport.ActiveStockUnitsCount, StringFormat='{}{0} Units'}" FontSize="15" FontWeight="Black" Foreground="#FBBF24" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Row 2: Payment Splits & Top Devices -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="4*"/>
                            <ColumnDefinition Width="6*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Collections Split -->
                        <Border Grid.Column="0" Background="#132035" BorderBrush="#223656" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,6,0">
                            <StackPanel>
                                <TextBlock Text="PAYMENT COLLECTIONS SPLIT" FontSize="11" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,0,8"/>
                                <Grid Margin="0,3">
                                    <TextBlock Text="Cash in Register:" FontSize="11" Foreground="#8FA3BF"/>
                                    <TextBlock Text="{Binding CurrentReport.CashCollected, StringFormat='₹{0:N2}'}" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Right"/>
                                </Grid>
                                <Grid Margin="0,3">
                                    <TextBlock Text="UPI Instant Credits:" FontSize="11" Foreground="#8FA3BF"/>
                                    <TextBlock Text="{Binding CurrentReport.UpiCollected, StringFormat='₹{0:N2}'}" FontSize="12" FontWeight="Bold" Foreground="#00E5FF" HorizontalAlignment="Right"/>
                                </Grid>
                                <Grid Margin="0,3">
                                    <TextBlock Text="Card Swipes (POS):" FontSize="11" Foreground="#8FA3BF"/>
                                    <TextBlock Text="{Binding CurrentReport.CardCollected, StringFormat='₹{0:N2}'}" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Right"/>
                                </Grid>
                                <Grid Margin="0,3">
                                    <TextBlock Text="Old Phone Trade-in:" FontSize="11" Foreground="#8FA3BF"/>
                                    <TextBlock Text="{Binding CurrentReport.ExchangeDeductions, StringFormat='₹{0:N2}'}" FontSize="12" FontWeight="Bold" Foreground="#FF9100" HorizontalAlignment="Right"/>
                                </Grid>
                                <Grid Margin="0,3">
                                    <TextBlock Text="Finance / Bajaj EMI:" FontSize="11" Foreground="#8FA3BF"/>
                                    <TextBlock Text="{Binding CurrentReport.FinanceEmiCollected, StringFormat='₹{0:N2}'}" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Right"/>
                                </Grid>
                                <Separator Background="#223656" Margin="0,6"/>
                                <Grid Margin="0,3">
                                    <TextBlock Text="Standard GST Tax:" FontSize="11" Foreground="#64748B"/>
                                    <TextBlock Text="{Binding CurrentReport.StandardTaxCollected, StringFormat='₹{0:N2}'}" FontSize="11" Foreground="#94A3B8" HorizontalAlignment="Right"/>
                                </Grid>
                                <Grid Margin="0,3">
                                    <TextBlock Text="Rule 32(5) Margin Tax:" FontSize="11" Foreground="#64748B"/>
                                    <TextBlock Text="{Binding CurrentReport.MarginTaxCollected, StringFormat='₹{0:N2}'}" FontSize="11" Foreground="#EA580C" HorizontalAlignment="Right"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Top Gadgets Sold DataGrid -->
                        <Border Grid.Column="1" Background="#132035" BorderBrush="#223656" BorderThickness="1" CornerRadius="8" Padding="8" Margin="6,0,0,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="ITEMS SOLD IN THIS SHIFT/PERIOD" FontSize="11" FontWeight="Bold" Foreground="#FBBF24" Margin="4,0,0,6"/>
                                <DataGrid Grid.Row="1" ItemsSource="{Binding CurrentReport.TopDevicesSold}" AutoGenerateColumns="False" 
                                          CanUserAddRows="False" IsReadOnly="True" Background="Transparent" BorderThickness="0" 
                                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#1C2D4A" Foreground="#FFFFFF" RowHeight="30"
                                          EnableRowVirtualization="True" AlternatingRowBackground="#0E192D">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="ITEM / MODEL" Binding="{Binding DeviceName}" FontWeight="Bold" Width="*"/>
                                        <DataGridTextColumn Header="QTY" Binding="{Binding QuantitySold}" Width="50"/>
                                        <DataGridTextColumn Header="REVENUE (₹)" Binding="{Binding TotalRevenue, StringFormat='₹{0:N0}'}" FontWeight="Black" Foreground="#00E5FF" Width="100"/>
                                        <DataGridTextColumn Header="PROFIT (₹)" Binding="{Binding TotalProfit, StringFormat='₹{0:N0}'}" FontWeight="Bold" Foreground="#4ADE80" Width="95"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ========================================================================= -->
            <!-- TAB 2: STOCK & IMEI MASTER CRUD EDITOR                                    -->
            <!-- ========================================================================= -->
            <TabItem Header="📱 Stock &amp; IMEI Full Editor">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="5.5*"/>
                        <ColumnDefinition Width="4.5*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Devices List -->
                    <Border Grid.Column="0" Background="#132035" BorderBrush="#223656" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,8,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/> <!-- Filters & PDF Export -->
                                <RowDefinition Height="Auto"/> <!-- Search Box -->
                                <RowDefinition Height="*"/>    <!-- DataGrid -->
                            </Grid.RowDefinitions>

                            <!-- Aging Filter Chips & PDF Export -->
                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Filter:" FontSize="11" FontWeight="Bold" Foreground="#8EA4C1" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <Button Command="{Binding SetStockAgingFilterCommand}" CommandParameter="All" Content="All" Height="24" Padding="6,1" Margin="0,0,4,0" Background="#1E293B" Foreground="#FFFFFF"/>
                                    <Button Command="{Binding SetStockAgingFilterCommand}" CommandParameter="Fresh" Content="Fresh (&lt;15d)" Height="24" Padding="6,1" Margin="0,0,4,0" Background="#1E293B" Foreground="#4ADE80"/>
                                    <Button Command="{Binding SetStockAgingFilterCommand}" CommandParameter="Aging30" Content="Slow Moving (&gt;30d)" Height="24" Padding="6,1" Margin="0,0,4,0" Background="#1E293B" Foreground="#F87171"/>
                                </StackPanel>

                                <Button Command="{Binding ExportLiveStockValuationPdfCommand}" HorizontalAlignment="Right" Height="26" Padding="8,1" 
                                        Background="#059669" Foreground="#FFFFFF" FontWeight="Bold" Cursor="Hand">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📄 " FontSize="11"/>
                                        <TextBlock Text="Live Stock Valuation PDF" FontSize="11"/>
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <TextBox Grid.Row="1" Text="{Binding StockSearchText, UpdateSourceTrigger=PropertyChanged}" 
                                     ToolTip="Search by IMEI 1, IMEI 2, Serial, or Model"
                                     Height="30" Padding="8,4" Background="#0A1424" Foreground="#00E5FF" BorderBrush="#00E5FF" BorderThickness="1" Margin="0,0,0,8"/>

                            <DataGrid Grid.Row="2" ItemsSource="{Binding StockUnits}" SelectedItem="{Binding SelectedUnit}"
                                      AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                      Background="Transparent" BorderThickness="0" HeadersVisibility="Column"
                                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#1C2D4A" Foreground="#FFFFFF" RowHeight="32"
                                      EnableRowVirtualization="True" AlternatingRowBackground="#0E192D">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="DEVICE" Binding="{Binding Product.Name}" FontWeight="Bold" Width="135"/>
                                    <DataGridTextColumn Header="IMEI 1" Binding="{Binding IMEI1}" Foreground="#00E5FF" Width="115"/>
                                    <DataGridTextColumn Header="BATTERY" Binding="{Binding BatteryHealthPercentage, StringFormat='{}{0}%'}" Width="60"/>
                                    <DataGridTextColumn Header="GRADE" Binding="{Binding ConditionGrade}" Width="75"/>
                                    <DataGridTextColumn Header="STATUS" Binding="{Binding Status}" FontWeight="Bold" Width="75"/>
                                    <DataGridTextColumn Header="PRICE" Binding="{Binding TaggedPrice, StringFormat='₹{0:N0}'}" FontWeight="Black" Foreground="#FF9100" Width="70"/>
                                    <DataGridTextColumn Header="AGING" Binding="{Binding AgingDays, StringFormat='{}{0}d'}" FontWeight="Bold" Foreground="#94A3B8" Width="55"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <!-- Right: In-Place Unit Mutation Form -->
                    <Border Grid.Column="1" Background="#111E38" BorderBrush="#1C2E52" BorderThickness="1" CornerRadius="8" Padding="14" Margin="8,0,0,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="EDIT DEVICE SPECS &amp; INVENTORY STATE" FontSize="12" FontWeight="Bold" Foreground="#00E5FF" Margin="0,0,0,8"/>
                                <TextBlock Text="{Binding SelectedUnit.Product.Name, FallbackValue='Select a device'}" FontSize="15" FontWeight="Black" Foreground="#FFFFFF" Margin="0,0,0,10"/>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                        <TextBlock Text="IMEI 1 (15-digit):" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,2"/>
                                        <TextBox Text="{Binding EditImei1, UpdateSourceTrigger=PropertyChanged}" Height="30" FontWeight="Bold" Foreground="#00E5FF"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                        <TextBlock Text="IMEI 2 (Optional):" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,2"/>
                                        <TextBox Text="{Binding EditImei2, UpdateSourceTrigger=PropertyChanged}" Height="30"/>
                                    </StackPanel>
                                </Grid>

                                <StackPanel Margin="0,0,0,8">
                                    <TextBlock Text="Serial Number:" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,2"/>
                                    <TextBox Text="{Binding EditSerialNumber, UpdateSourceTrigger=PropertyChanged}" Height="30"/>
                                </StackPanel>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                        <TextBlock Text="Cost (₹):" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,2"/>
                                        <TextBox Text="{Binding EditCost, UpdateSourceTrigger=PropertyChanged}" Height="30" FontWeight="Bold"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="4,0,4,0">
                                        <TextBlock Text="Price (₹):" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,2"/>
                                        <TextBox Text="{Binding EditPrice, UpdateSourceTrigger=PropertyChanged}" Height="30" FontWeight="Bold" Foreground="#FF9100"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Margin="4,0,0,0">
                                        <TextBlock Text="Battery %:" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,2"/>
                                        <TextBox Text="{Binding EditBattery, UpdateSourceTrigger=PropertyChanged}" Height="30" FontWeight="Bold" Foreground="#4ADE80"/>
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                        <TextBlock Text="Condition Grade:" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,2"/>
                                        <ComboBox ItemsSource="{Binding AvailableGrades}" SelectedItem="{Binding EditGrade}" Height="30"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                        <TextBlock Text="Inventory Status:" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,2"/>
                                        <ComboBox ItemsSource="{Binding AvailableStatuses}" SelectedItem="{Binding EditStatus}" Height="30" FontWeight="Bold"/>
                                    </StackPanel>
                                </Grid>

                                <StackPanel Margin="0,0,0,12">
                                    <TextBlock Text="Warranty Status:" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,2"/>
                                    <ComboBox ItemsSource="{Binding AvailableWarranties}" SelectedItem="{Binding EditWarranty}" Height="30"/>
                                </StackPanel>

                                <Button Command="{Binding SaveSelectedUnitChangesCommand}" Background="#00E5FF" Foreground="#08101E" 
                                        FontWeight="Black" Height="36" Cursor="Hand">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="💾 " FontSize="12"/>
                                        <TextBlock Text="Save Changes &amp; Log Audit" FontSize="12"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ========================================================================= -->
            <!-- TAB 3: CUSTOMER MASTER & KHATA CREDIT MANAGER                             -->
            <!-- ========================================================================= -->
            <TabItem Header="👥 Customer Khata &amp; Ledger">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="5*"/>
                        <ColumnDefinition Width="5*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Customers List -->
                    <Border Grid.Column="0" Background="#132035" BorderBrush="#223656" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,8,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBox Grid.Row="0" Text="{Binding CustomerSearchText, UpdateSourceTrigger=PropertyChanged}" 
                                     ToolTip="Search customer by name or phone"
                                     Height="32" Padding="8,4" Background="#0A1424" Foreground="#00E5FF" BorderBrush="#00E5FF" BorderThickness="1" Margin="0,0,0,8"/>

                            <DataGrid Grid.Row="1" ItemsSource="{Binding Customers}" SelectedItem="{Binding SelectedCustomer}"
                                      AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                      Background="Transparent" BorderThickness="0" HeadersVisibility="Column"
                                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#1C2D4A" Foreground="#FFFFFF" RowHeight="32"
                                      EnableRowVirtualization="True" AlternatingRowBackground="#0E192D">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="CUSTOMER NAME" Binding="{Binding FullName}" FontWeight="Bold" Width="140"/>
                                    <DataGridTextColumn Header="PHONE" Binding="{Binding PhoneNumber}" Foreground="#00E5FF" Width="100"/>
                                    <DataGridTextColumn Header="KHATA DEBT (₹)" Binding="{Binding OutstandingCredit, StringFormat='₹{0:N2}'}" FontWeight="Black" Foreground="#F87171" Width="110"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <!-- Right: Profile Editor & Settlement -->
                    <Border Grid.Column="1" Background="#111E38" BorderBrush="#1C2E52" BorderThickness="1" CornerRadius="8" Padding="14" Margin="8,0,0,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="CUSTOMER PROFILE &amp; KHATA SETTLEMENT" FontSize="12" FontWeight="Bold" Foreground="#00E5FF" Margin="0,0,0,8"/>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                        <TextBlock Text="Full Name:" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,2"/>
                                        <TextBox Text="{Binding EditCustomerName, UpdateSourceTrigger=PropertyChanged}" Height="30" FontWeight="Bold"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                        <TextBlock Text="Phone:" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,2"/>
                                        <TextBox Text="{Binding EditCustomerPhone, UpdateSourceTrigger=PropertyChanged}" Height="30" FontWeight="Bold"/>
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                        <TextBlock Text="GSTIN:" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,2"/>
                                        <TextBox Text="{Binding EditCustomerGstin, UpdateSourceTrigger=PropertyChanged}" Height="30"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                        <TextBlock Text="Aadhaar / ID:" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,2"/>
                                        <TextBox Text="{Binding EditCustomerAadhaar, UpdateSourceTrigger=PropertyChanged}" Height="30"/>
                                    </StackPanel>
                                </Grid>

                                <StackPanel Margin="0,0,0,10">
                                    <TextBlock Text="Address:" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,2"/>
                                    <TextBox Text="{Binding EditCustomerAddress, UpdateSourceTrigger=PropertyChanged}" Height="30"/>
                                </StackPanel>

                                <Button Command="{Binding SaveCustomerChangesCommand}" Background="#1E293B" BorderBrush="#475569" BorderThickness="1" 
                                        Foreground="#E2E8F0" FontWeight="Bold" Height="30" Cursor="Hand" Margin="0,0,0,14">
                                    <TextBlock Text="Save Customer Profile"/>
                                </Button>

                                <Separator Background="#223656" Margin="0,4,0,12"/>

                                <!-- Khata Debt Settlement Box -->
                                <Border Background="#1A1828" BorderBrush="#F87171" BorderThickness="1" CornerRadius="6" Padding="12">
                                    <StackPanel>
                                        <TextBlock Text="KHATA BALANCE SETTLEMENT" FontSize="11" FontWeight="Black" Foreground="#F87171" Margin="0,0,0,6"/>
                                        <Grid Margin="0,0,0,6">
                                            <TextBlock Text="Outstanding Debt:" FontSize="11" Foreground="#94A3B8"/>
                                            <TextBlock Text="{Binding SelectedCustomer.OutstandingCredit, StringFormat='₹{0:N2}', FallbackValue='₹0.00'}" FontSize="13" FontWeight="Black" Foreground="#F87171" HorizontalAlignment="Right"/>
                                        </Grid>

                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                                <TextBlock Text="Payment (₹):" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,2"/>
                                                <TextBox Text="{Binding SettleAmount, UpdateSourceTrigger=PropertyChanged}" Height="30" FontWeight="Black" Foreground="#4ADE80"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                                <TextBlock Text="Mode:" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,2"/>
                                                <ComboBox ItemsSource="{Binding AvailablePaymentModes}" SelectedItem="{Binding SettlePaymentMode}" Height="30"/>
                                            </StackPanel>
                                        </Grid>

                                        <Button Command="{Binding SettleCustomerKhataCommand}" Background="#16A34A" Foreground="#FFFFFF" 
                                                FontWeight="Black" Height="32" Cursor="Hand" Margin="0,4,0,0">
                                            <TextBlock Text="💰 Receive Payment &amp; Settle Khata"/>
                                        </Button>

                                        <Button Command="{Binding ExportCustomerKhataPdfCommand}" Background="#D97706" Foreground="#FFFFFF" 
                                                FontWeight="Black" Height="32" Cursor="Hand" Margin="0,8,0,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="📄 " FontSize="12"/>
                                                <TextBlock Text="Export Customer Khata Statement (PDF)"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ========================================================================= -->
            <!-- TAB 4: ADMINISTRATIVE INVOICE VOIDING, OVERRIDE & PAYMENT SPLIT EDITOR    -->
            <!-- ========================================================================= -->
            <TabItem Header="🔒 Void Invoice &amp; Overrides">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="5*"/>
                        <ColumnDefinition Width="5*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Invoices List -->
                    <Border Grid.Column="0" Background="#132035" BorderBrush="#223656" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,8,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBox Grid.Row="0" Text="{Binding VoidSearchText, UpdateSourceTrigger=PropertyChanged}" 
                                     ToolTip="Search invoice by number or phone"
                                     Height="32" Padding="8,4" Background="#0A1424" Foreground="#00E5FF" BorderBrush="#00E5FF" BorderThickness="1" Margin="0,0,0,8"/>

                            <DataGrid Grid.Row="1" ItemsSource="{Binding VoidableInvoices}" SelectedItem="{Binding SelectedVoidInvoice}"
                                      AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                      Background="Transparent" BorderThickness="0" HeadersVisibility="Column"
                                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#1C2D4A" Foreground="#FFFFFF" RowHeight="32"
                                      EnableRowVirtualization="True" AlternatingRowBackground="#0E192D">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="INVOICE #" Binding="{Binding InvoiceNumber}" FontWeight="Bold" Foreground="#00E5FF" Width="120"/>
                                    <DataGridTextColumn Header="DATE" Binding="{Binding InvoiceDate, StringFormat='{}{0:dd-MMM-yy}'}" Width="85"/>
                                    <DataGridTextColumn Header="CUSTOMER" Binding="{Binding CustomerName}" Width="120"/>
                                    <DataGridTextColumn Header="AMOUNT (₹)" Binding="{Binding GrandTotal, StringFormat='₹{0:N0}'}" FontWeight="Black" Foreground="#FF9100" Width="85"/>
                                    <DataGridTextColumn Header="BALANCE (₹)" Binding="{Binding BalanceDue, StringFormat='₹{0:N0}'}" FontWeight="Bold" Foreground="#F87171" Width="85"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <!-- Right: Editor & Void Controls -->
                    <Border Grid.Column="1" Background="#111E38" BorderBrush="#1C2E52" BorderThickness="1" CornerRadius="8" Padding="12" Margin="8,0,0,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <!-- Selected Header Banner -->
                                <Border Background="#1A2846" BorderBrush="#00E5FF" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="SELECTED INVOICE:" FontSize="9" FontWeight="Bold" Foreground="#00E5FF"/>
                                            <TextBlock Text="{Binding SelectedVoidInvoice.InvoiceNumber, FallbackValue='None selected'}" FontSize="15" FontWeight="Black" Foreground="#FFFFFF"/>
                                            <TextBlock Text="{Binding SelectedVoidInvoice.CustomerName, FallbackValue=''}" FontSize="11" Foreground="#94A3B8"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding SelectedVoidInvoice.GrandTotal, StringFormat='₹{0:N2}', FallbackValue=''}" FontSize="15" FontWeight="Black" Foreground="#FFD700" HorizontalAlignment="Right"/>
                                            <TextBlock Text="{Binding SelectedVoidInvoice.BalanceDue, StringFormat='Due: ₹{0:N2}', FallbackValue=''}" FontSize="11" FontWeight="Bold" Foreground="#F87171" HorizontalAlignment="Right"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- 1. Payment Split In-Place Editor -->
                                <Border Background="#162544" BorderBrush="#22365D" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="✏️ IN-PLACE PAYMENT SPLIT &amp; NOTES EDITOR" FontSize="11" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,0,8"/>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                                <TextBlock Text="Cash (₹):" FontSize="10" Foreground="#94A3B8" Margin="0,0,0,1"/>
                                                <TextBox Text="{Binding EditCashAmount, UpdateSourceTrigger=PropertyChanged}" Height="28"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                                <TextBlock Text="UPI (₹):" FontSize="10" Foreground="#94A3B8" Margin="0,0,0,1"/>
                                                <TextBox Text="{Binding EditUpiAmount, UpdateSourceTrigger=PropertyChanged}" Height="28" Foreground="#00E5FF"/>
                                            </StackPanel>
                                        </Grid>

                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                                <TextBlock Text="Card (POS ₹):" FontSize="10" Foreground="#94A3B8" Margin="0,0,0,1"/>
                                                <TextBox Text="{Binding EditCardAmount, UpdateSourceTrigger=PropertyChanged}" Height="28"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                                <TextBlock Text="Exchange Value (₹):" FontSize="10" Foreground="#94A3B8" Margin="0,0,0,1"/>
                                                <TextBox Text="{Binding EditExchangeDeduction, UpdateSourceTrigger=PropertyChanged}" Height="28" Foreground="#FF9100"/>
                                            </StackPanel>
                                        </Grid>

                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                                <TextBlock Text="Finance / EMI (₹):" FontSize="10" Foreground="#94A3B8" Margin="0,0,0,1"/>
                                                <TextBox Text="{Binding EditFinanceEmiAmount, UpdateSourceTrigger=PropertyChanged}" Height="28"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                                <TextBlock Text="Ref / Auth Code:" FontSize="10" Foreground="#94A3B8" Margin="0,0,0,1"/>
                                                <TextBox Text="{Binding EditInvoicePaymentRef, UpdateSourceTrigger=PropertyChanged}" Height="28"/>
                                            </StackPanel>
                                        </Grid>

                                        <StackPanel Margin="0,0,0,8">
                                            <TextBlock Text="Remarks / Audit Note:" FontSize="10" Foreground="#94A3B8" Margin="0,0,0,1"/>
                                            <TextBox Text="{Binding EditPaymentNotes, UpdateSourceTrigger=PropertyChanged}" Height="28"/>
                                        </StackPanel>

                                        <Button Command="{Binding SaveInvoicePaymentSplitCommand}" Background="#0284C7" Foreground="#FFFFFF" 
                                                FontWeight="Bold" Height="30" Cursor="Hand">
                                            <TextBlock Text="💾 Save Payment Split &amp; Rebalance Ledgers"/>
                                        </Button>
                                    </StackPanel>
                                </Border>

                                <!-- 2. Void Confirmation Box -->
                                <Border Background="#1C141B" BorderBrush="#EF4444" BorderThickness="1" CornerRadius="6" Padding="10">
                                    <StackPanel>
                                        <TextBlock Text="🚫 ADMINISTRATIVE INVOICE CANCELLATION (VOID)" FontSize="11" FontWeight="Black" Foreground="#EF4444" Margin="0,0,0,4"/>
                                        <TextBlock Text="Cancelling an invoice immediately restores sold devices back to InStock, decrements sales figures, and writes balancing double-entry ledger reversals." 
                                                   FontSize="9.5" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,0,0,8"/>

                                        <TextBlock Text="Reason for Cancellation:" FontSize="10" Foreground="#94A3B8" Margin="0,0,0,2"/>
                                        <TextBox Text="{Binding VoidReason, UpdateSourceTrigger=PropertyChanged}" Height="40" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,10"/>

                                        <Button Command="{Binding VoidSelectedInvoiceCommand}" Background="#DC2626" Foreground="#FFFFFF" 
                                                FontWeight="Black" Height="34" Cursor="Hand">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="⚠️ " FontSize="12"/>
                                                <TextBlock Text="CONFIRM VOID &amp; RESTOCK TO SHELF" FontSize="11"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- 3. Status Bar -->
        <Border Grid.Row="2" Background="{DynamicResource SasanHeaderBgBrush}" BorderBrush="{DynamicResource SasanBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,10,0,0">
            <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="{DynamicResource SasanAmberAccentBrush}" VerticalAlignment="Center"/>
        </Border>
    </Grid>
</UserControl>
