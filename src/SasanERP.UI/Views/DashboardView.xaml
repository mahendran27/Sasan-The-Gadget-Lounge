<UserControl x:Class="SasanERP.UI.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:SasanERP.UI.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1100">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="20,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Title & Refresh -->
                <RowDefinition Height="Auto"/> <!-- Top 4 Metric Cards -->
                <RowDefinition Height="Auto"/> <!-- Secondary 4 Metric Cards -->
                <RowDefinition Height="*"/>    <!-- Data Tables Grid -->
            </Grid.RowDefinitions>

            <!-- 1. Header Bar -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="EXECUTIVE DASHBOARD &amp; REAL-TIME METRICS" FontSize="18" FontWeight="Black" Foreground="#FFFFFF"/>
                    <TextBlock Text="Live retail telemetry, Rule 32(5) margin profits, stock valuation, and cashier collections" 
                               FontSize="12" Foreground="#8EA4C1" Margin="0,2,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Command="{Binding RefreshMetricsCommand}" Background="#1C2D4A" Foreground="#00E5FF" 
                        Padding="14,6" BorderBrush="#00E5FF" BorderThickness="1" Cursor="Hand" FontWeight="Bold">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🔄 "/>
                        <TextBlock Text="Refresh Live Telemetry"/>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- 2. Primary KPI Cards (4-Column Grid) -->
            <Grid Grid.Row="1" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Card 1: Today's Revenue -->
                <Border Grid.Column="0" Background="#132035" BorderBrush="#223656" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,8,0">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="TODAY'S REVENUE" FontSize="11" FontWeight="Bold" Foreground="#8FA3BF"/>
                            <TextBlock Text="₹" FontSize="14" FontWeight="Bold" Foreground="#00E5FF" HorizontalAlignment="Right"/>
                        </Grid>
                        <TextBlock Text="{Binding TodaySales, StringFormat='₹{0:N0}'}" FontSize="24" FontWeight="Black" Foreground="#00E5FF" Margin="0,6,0,0"/>
                        <TextBlock Text="{Binding TodayInvoicesCount, StringFormat='{}{0} Invoices Billed Today'}" FontSize="11" Foreground="#4CAF50" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Card 2: Estimated Net Profit -->
                <Border Grid.Column="1" Background="#132035" BorderBrush="#223656" BorderThickness="1" CornerRadius="8" Padding="16" Margin="4,0,4,0">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="TODAY'S NET PROFIT" FontSize="11" FontWeight="Bold" Foreground="#8FA3BF"/>
                            <TextBlock Text="📈" FontSize="14" HorizontalAlignment="Right"/>
                        </Grid>
                        <TextBlock Text="{Binding TodayNetProfit, StringFormat='₹{0:N0}'}" FontSize="24" FontWeight="Black" Foreground="#66BB6A" Margin="0,6,0,0"/>
                        <TextBlock Text="Gross Margin on Items Sold" FontSize="11" Foreground="#8EA4C1" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Card 3: Stock Valuation -->
                <Border Grid.Column="2" Background="#132035" BorderBrush="#223656" BorderThickness="1" CornerRadius="8" Padding="16" Margin="4,0,4,0">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="STOCK VALUATION (NEW)" FontSize="11" FontWeight="Bold" Foreground="#8FA3BF"/>
                            <TextBlock Text="📦" FontSize="14" HorizontalAlignment="Right"/>
                        </Grid>
                        <TextBlock Text="{Binding StockValuationNew, StringFormat='₹{0:N0}'}" FontSize="24" FontWeight="Black" Foreground="#FFFFFF" Margin="0,6,0,0"/>
                        <TextBlock Text="{Binding InStockBulkItemsCount, StringFormat='{}{0} Bulk Units in Stock'}" FontSize="11" Foreground="#8EA4C1" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Card 4: Pre-Owned Valuation (Rule 32(5)) -->
                <Border Grid.Column="3" Background="#132035" BorderBrush="#223656" BorderThickness="1" CornerRadius="8" Padding="16" Margin="8,0,0,0">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="PRE-OWNED GADGETS" FontSize="11" FontWeight="Bold" Foreground="#8FA3BF"/>
                            <TextBlock Text="💎" FontSize="14" HorizontalAlignment="Right"/>
                        </Grid>
                        <TextBlock Text="{Binding StockValuationPreOwned, StringFormat='₹{0:N0}'}" FontSize="24" FontWeight="Black" Foreground="#FF9100" Margin="0,6,0,0"/>
                        <TextBlock Text="{Binding InStockDevicesCount, StringFormat='{}{0} Serialized Devices Available'}" FontSize="11" Foreground="#FFB74D" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 3. Secondary KPI Cards (Collections & Alerts) -->
            <Grid Grid.Row="2" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Today Cash Collections -->
                <Border Grid.Column="0" Background="#0C182B" BorderBrush="#1C2D4A" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,8,0">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="CASH IN DRAWER" FontSize="10" FontWeight="Bold" Foreground="#8FA3BF"/>
                            <TextBlock Text="{Binding TodayCash, StringFormat='₹{0:N0}'}" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,2,0,0"/>
                        </StackPanel>
                        <TextBlock Text="💵" FontSize="16" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Today UPI Collections -->
                <Border Grid.Column="1" Background="#0C182B" BorderBrush="#1C2D4A" BorderThickness="1" CornerRadius="6" Padding="12" Margin="4,0,4,0">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="UPI / BANK QR" FontSize="10" FontWeight="Bold" Foreground="#8FA3BF"/>
                            <TextBlock Text="{Binding TodayUpi, StringFormat='₹{0:N0}'}" FontSize="16" FontWeight="Bold" Foreground="#00E5FF" Margin="0,2,0,0"/>
                        </StackPanel>
                        <TextBlock Text="📱" FontSize="16" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Aging Inventory Warning -->
                <Border Grid.Column="2" Background="#261A14" BorderBrush="#FF9100" BorderThickness="1" CornerRadius="6" Padding="12" Margin="4,0,4,0">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="STOCK AGING (>60 DAYS)" FontSize="10" FontWeight="Bold" Foreground="#FFB74D"/>
                            <TextBlock Text="{Binding StockAgingAlertsCount, StringFormat='{}{0} Devices'}" FontSize="16" FontWeight="Black" Foreground="#FF9100" Margin="0,2,0,0"/>
                        </StackPanel>
                        <TextBlock Text="⚠️" FontSize="16" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Low Stock Reorder Warning -->
                <Border Grid.Column="3" Background="#261414" BorderBrush="#EF5350" BorderThickness="1" CornerRadius="6" Padding="12" Margin="8,0,0,0">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="LOW STOCK REORDER" FontSize="10" FontWeight="Bold" Foreground="#EF9A9A"/>
                            <TextBlock Text="{Binding LowStockAlertsCount, StringFormat='{}{0} Items Low'}" FontSize="16" FontWeight="Black" Foreground="#FF5252" Margin="0,2,0,0"/>
                        </StackPanel>
                        <TextBlock Text="🚨" FontSize="16" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- 4. Data Tables (Recent Invoices & Aging Stock) -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="6*"/>
                    <ColumnDefinition Width="4*"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Recent Invoices Table -->
                <Border Grid.Column="0" Background="#132035" BorderBrush="#223656" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,8,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="RECENT SALES INVOICES &amp; AUDIT FEED" FontSize="12" FontWeight="Bold" Foreground="#8EA4C1" Margin="0,0,0,10"/>
                        <DataGrid Grid.Row="1" ItemsSource="{Binding RecentInvoices}" AutoGenerateColumns="False" 
                                  CanUserAddRows="False" IsReadOnly="True" Background="Transparent" 
                                  BorderThickness="0" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#1C2D4A" Foreground="#FFFFFF" RowHeight="32">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="INV NO" Binding="{Binding InvoiceNumber}" FontWeight="Bold" Width="120"/>
                                <DataGridTextColumn Header="CUSTOMER" Binding="{Binding CustomerName}" Width="*"/>
                                <DataGridTextColumn Header="TIME" Binding="{Binding InvoiceDate, StringFormat='hh:mm tt'}" Width="80"/>
                                <DataGridTextColumn Header="PAYMENT" Binding="{Binding PaymentModes}" Width="100"/>
                                <DataGridTextColumn Header="TOTAL" Binding="{Binding GrandTotal, StringFormat='₹{0:N2}'}" FontWeight="Black" Width="100"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <!-- Right: Aging Stock Radar -->
                <Border Grid.Column="1" Background="#132035" BorderBrush="#223656" BorderThickness="1" CornerRadius="8" Padding="14" Margin="8,0,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="STOCK AGING RADAR (>60 DAYS UNSOLD)" FontSize="12" FontWeight="Bold" Foreground="#FF9100" Margin="0,0,0,10"/>
                        <DataGrid Grid.Row="1" ItemsSource="{Binding AgingDevices}" AutoGenerateColumns="False" 
                                  CanUserAddRows="False" IsReadOnly="True" Background="Transparent" 
                                  BorderThickness="0" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#1C2D4A" Foreground="#FFFFFF" RowHeight="32">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="DEVICE" Binding="{Binding DeviceName}" Width="*"/>
                                <DataGridTextColumn Header="IMEI" Binding="{Binding IMEI1}" Width="110"/>
                                <DataGridTextColumn Header="AGING" Binding="{Binding AgingDays, StringFormat='{}{0}d'}" FontWeight="Bold" Width="60"/>
                                <DataGridTextColumn Header="PRICE" Binding="{Binding TaggedPrice, StringFormat='₹{0:N0}'}" FontWeight="Bold" Width="80"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
