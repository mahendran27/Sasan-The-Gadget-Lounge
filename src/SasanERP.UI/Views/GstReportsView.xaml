<UserControl x:Class="SasanERP.UI.Views.GstReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1100">

    <Grid Margin="20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Title & Controls -->
            <RowDefinition Height="Auto"/> <!-- Month Selector & Tax Summary Cards -->
            <RowDefinition Height="*"/>    <!-- Invoices Grid -->
            <RowDefinition Height="Auto"/> <!-- Status & Export Bar -->
        </Grid.RowDefinitions>

        <!-- 1. Header -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="INDIAN GST AUDIT &amp; GSTR-1 FILING HUB" FontSize="18" FontWeight="Black" Foreground="#FFFFFF"/>
                <TextBlock Text="Statutory tax breakdown covering Standard GST (CGST/SGST) and Rule 32(5) Pre-Owned Margin Scheme" 
                           FontSize="12" Foreground="#8EA4C1" Margin="0,2,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Command="{Binding LoadGstDataCommand}" Background="#1C2D4A" Foreground="#00E5FF" 
                        Padding="12,6" BorderBrush="#00E5FF" BorderThickness="1" Cursor="Hand" FontWeight="Bold" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🔄 "/>
                        <TextBlock Text="Recalculate Taxes"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding ExportGstr1ExcelCommand}" Background="#2E7D32" Foreground="#FFFFFF" 
                        Padding="14,6" BorderThickness="0" Cursor="Hand" FontWeight="Black">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📊 "/>
                        <TextBlock Text="Export GSTR-1 Excel File"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- 2. Tax Summary Cards & Month Filter -->
        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Month / Year Selector -->
            <Border Grid.Column="0" Background="#132035" BorderBrush="#223656" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,8,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Period:" FontSize="12" Foreground="#8FA3BF" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox ItemsSource="{Binding Months}" SelectedItem="{Binding SelectedMonth}" Width="60" Height="28" Margin="0,0,6,0"/>
                    <ComboBox ItemsSource="{Binding Years}" SelectedItem="{Binding SelectedYear}" Width="80" Height="28"/>
                </StackPanel>
            </Border>

            <!-- Standard Taxable -->
            <Border Grid.Column="1" Background="#132035" BorderBrush="#223656" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="4,0,4,0">
                <StackPanel>
                    <TextBlock Text="STD TAXABLE (NEW)" FontSize="10" FontWeight="Bold" Foreground="#8FA3BF"/>
                    <TextBlock Text="{Binding StandardTaxableTotal, StringFormat='₹{0:N0}'}" FontSize="16" FontWeight="Black" Foreground="#FFFFFF" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <!-- CGST / SGST -->
            <Border Grid.Column="2" Background="#132035" BorderBrush="#223656" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="4,0,4,0">
                <StackPanel>
                    <TextBlock Text="OUTPUT CGST + SGST" FontSize="10" FontWeight="Bold" Foreground="#8FA3BF"/>
                    <TextBlock Text="{Binding CgstTotal, StringFormat='₹{0:N0}'}" FontSize="16" FontWeight="Black" Foreground="#00E5FF" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <!-- Rule 32(5) Margin Profit -->
            <Border Grid.Column="3" Background="#261A14" BorderBrush="#FF9100" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="4,0,4,0">
                <StackPanel>
                    <TextBlock Text="RULE 32(5) MARGIN PROFIT" FontSize="10" FontWeight="Bold" Foreground="#FFB74D"/>
                    <TextBlock Text="{Binding MarginProfitTotal, StringFormat='₹{0:N0}'}" FontSize="16" FontWeight="Black" Foreground="#FF9100" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <!-- Total Tax Liability -->
            <Border Grid.Column="4" Background="#1B2B1B" BorderBrush="#4CAF50" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="8,0,0,0">
                <StackPanel>
                    <TextBlock Text="TOTAL GST PAYABLE" FontSize="10" FontWeight="Bold" Foreground="#A5D6A7"/>
                    <TextBlock Text="{Binding TotalGstLiability, StringFormat='₹{0:N0}'}" FontSize="16" FontWeight="Black" Foreground="#4CAF50" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 3. Invoices Breakdown Grid -->
        <Border Grid.Row="2" Background="#132035" BorderBrush="#223656" BorderThickness="1" CornerRadius="8" Padding="10">
            <DataGrid ItemsSource="{Binding Invoices}" AutoGenerateColumns="False" CanUserAddRows="False"
                      IsReadOnly="True" Background="Transparent" BorderThickness="0" HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#1C2D4A" Foreground="#FFFFFF" RowHeight="32">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="INVOICE NO" Binding="{Binding InvoiceNumber}" FontWeight="Bold" Width="130"/>
                    <DataGridTextColumn Header="DATE" Binding="{Binding InvoiceDate, StringFormat='dd-MMM-yyyy'}" Width="100"/>
                    <DataGridTextColumn Header="CUSTOMER" Binding="{Binding CustomerName}" Width="150"/>
                    <DataGridTextColumn Header="GSTIN" Binding="{Binding GSTIN}" Width="140"/>
                    <DataGridTextColumn Header="TOTAL (₹)" Binding="{Binding InvoiceTotal, StringFormat='₹{0:N2}'}" FontWeight="Black" Width="100"/>
                    <DataGridTextColumn Header="STD TAXABLE" Binding="{Binding StandardTaxable, StringFormat='₹{0:N2}'}" Width="100"/>
                    <DataGridTextColumn Header="CGST (9%)" Binding="{Binding CGST, StringFormat='₹{0:N2}'}" Width="90"/>
                    <DataGridTextColumn Header="SGST (9%)" Binding="{Binding SGST, StringFormat='₹{0:N2}'}" Width="90"/>
                    <DataGridTextColumn Header="MARGIN PROFIT" Binding="{Binding MarginAmount, StringFormat='₹{0:N2}'}" Foreground="#FF9100" Width="110"/>
                    <DataGridTextColumn Header="MARGIN TAX" Binding="{Binding MarginTax, StringFormat='₹{0:N2}'}" Foreground="#FF9100" Width="100"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- 4. Footer & Status -->
        <Border Grid.Row="3" Background="#0C182B" BorderBrush="#1C2D4A" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,10,0,0">
            <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="#8EA4C1"/>
        </Border>
    </Grid>
</UserControl>
