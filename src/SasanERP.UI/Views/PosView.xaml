<UserControl x:Class="SasanERP.UI.Views.PosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" 
             d:DesignHeight="750" d:DesignWidth="1100"
             PreviewKeyDown="UserControl_PreviewKeyDown">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid Margin="14,8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="7*" /> <!-- Left: Barcode Scanner & Cart -->
            <ColumnDefinition Width="4*" /> <!-- Right: Billing Summary & Payment -->
        </Grid.ColumnDefinitions>

        <!-- LEFT COLUMN: SCANNER & CART -->
        <Grid Grid.Column="0" Margin="0,0,10,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /> <!-- Customer & Scanner Box -->
                <RowDefinition Height="*" />    <!-- Cart Grid -->
            </Grid.RowDefinitions>

            <!-- Customer Selection, Barcode Scanner Input, Customer Drawer, Held Bills Drawer & Manual Item Entry -->
            <Border Grid.Row="0" Background="{DynamicResource SasanCardBgBrush}" BorderBrush="{DynamicResource SasanBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /> <!-- Customer Selection Row -->
                        <RowDefinition Height="Auto" /> <!-- Customer Telemetry & Credit Badge -->
                        <RowDefinition Height="Auto" /> <!-- In-Place Customer Drawer -->
                        <RowDefinition Height="Auto" /> <!-- Held Bills Queue Drawer -->
                        <RowDefinition Height="Auto" /> <!-- USB Barcode Scanner Input -->
                        <RowDefinition Height="Auto" /> <!-- Manual Custom Item Panel -->
                    </Grid.RowDefinitions>

                    <!-- Row 0: Customer Selector & Action Buttons -->
                    <Grid Grid.Row="0" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="Customer:" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource SasanSubTextBrush}" 
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>

                        <ComboBox Grid.Column="1" ItemsSource="{Binding Customers}" 
                                  SelectedItem="{Binding SelectedCustomer}"
                                  DisplayMemberPath="FullName"
                                  Height="34" FontSize="13" Background="{DynamicResource SasanInputBgBrush}" Foreground="{DynamicResource SasanForegroundBrush}"/>

                        <!-- + New Customer Button -->
                        <Button Grid.Column="2" Command="{Binding OpenNewCustomerCommand}"
                                Content="➕ NEW (F4)" Height="34" Margin="6,0,0,0" Padding="10,0"
                                Background="{DynamicResource SasanCyanAccentBrush}" Foreground="#08101E" FontWeight="Bold" FontSize="11" Cursor="Hand"
                                ToolTip="Register new customer directly into database &amp; invoice (F4)"/>

                        <!-- Edit Customer Button -->
                        <Button Grid.Column="3" Command="{Binding OpenEditCustomerCommand}"
                                Content="✏️ EDIT" Height="34" Margin="6,0,0,0" Padding="8,0"
                                Background="{DynamicResource SasanBorderBrush}" Foreground="{DynamicResource SasanForegroundBrush}" FontWeight="SemiBold" FontSize="11" Cursor="Hand"
                                ToolTip="Edit selected customer profile in database"/>

                        <!-- Hold / Park Current Bill Button -->
                        <Button Grid.Column="4" Command="{Binding HoldCurrentBillCommand}"
                                Content="⏸️ HOLD (F6)" Height="34" Margin="6,0,0,0" Padding="8,0"
                                Background="#332A15" Foreground="{DynamicResource SasanAmberAccentBrush}" BorderBrush="{DynamicResource SasanAmberAccentBrush}" BorderThickness="1"
                                FontWeight="Bold" FontSize="11" Cursor="Hand"
                                ToolTip="Park current bill in queue to serve next customer (F6)"/>

                        <!-- Held Bills Queue Button -->
                        <Button Grid.Column="5" Command="{Binding ToggleHeldBillsDrawerCommand}"
                                Height="34" Margin="6,0,0,0" Padding="8,0"
                                Background="{DynamicResource SasanHeaderBgBrush}" Foreground="{DynamicResource SasanForegroundBrush}" BorderBrush="{DynamicResource SasanBorderBrush}" BorderThickness="1"
                                FontWeight="Bold" FontSize="11" Cursor="Hand"
                                ToolTip="View and recall parked customer bills (F7)">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📦 PARKED: " FontSize="10" Foreground="{DynamicResource SasanSubTextBrush}"/>
                                <TextBlock Text="{Binding HeldBills.Count}" FontSize="11" FontWeight="Black" Foreground="{DynamicResource SasanCyanAccentBrush}"/>
                            </StackPanel>
                        </Button>

                        <!-- Bill Number Badge -->
                        <Border Grid.Column="6" Background="{DynamicResource SasanHeaderBgBrush}" BorderBrush="{DynamicResource SasanBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,4" Margin="8,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="BILL: " FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SasanSubTextBrush}"/>
                                <TextBlock Text="{Binding InvoiceNumber}" FontSize="12" FontWeight="Black" Foreground="{DynamicResource SasanCyanAccentBrush}"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Row 1: Selected Customer Telemetry & Credit Badge Bar -->
                    <Border Grid.Row="1" Background="{DynamicResource SasanHeaderBgBrush}" BorderBrush="{DynamicResource SasanBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,0,0,8"
                            Visibility="{Binding HasSelectedCustomer, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="📞 " FontSize="11"/>
                                <TextBlock Text="{Binding SelectedCustomer.PhoneNumber}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SasanForegroundBrush}"/>
                                <TextBlock Text=" | 📍 " FontSize="11" Margin="8,0,0,0"/>
                                <TextBlock Text="{Binding SelectedCustomer.City, FallbackValue='Theni'}" FontSize="11" Foreground="{DynamicResource SasanSubTextBrush}"/>
                                <TextBlock Text=" (State: 33 TN)" FontSize="10" Foreground="{DynamicResource SasanSubTextBrush}"/>
                            </StackPanel>

                            <!-- GSTIN Badge if B2B registered -->
                            <Border Grid.Column="2" Background="#0C253D" BorderBrush="{DynamicResource SasanCyanAccentBrush}" BorderThickness="1" CornerRadius="3" Padding="6,1" Margin="8,0" VerticalAlignment="Center"
                                    Visibility="{Binding HasGstin, Converter={StaticResource BoolToVis}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="B2B GSTIN: " FontSize="9" FontWeight="Bold" Foreground="{DynamicResource SasanSubTextBrush}"/>
                                    <TextBlock Text="{Binding SelectedCustomer.GSTIN}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource SasanCyanAccentBrush}"/>
                                </StackPanel>
                            </Border>

                            <!-- Customer Khata Outstanding Credit Badge -->
                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Khata Balance: " FontSize="11" Foreground="{DynamicResource SasanSubTextBrush}"/>
                                <TextBlock Text="{Binding SelectedCustomer.OutstandingCredit, StringFormat='₹{0:N2}'}" FontSize="11" FontWeight="Black" 
                                           Foreground="{DynamicResource SasanAmberAccentBrush}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Row 2: In-Place Customer Creation / Edit Drawer (Collapsible) -->
                    <Border Grid.Row="2" Background="{DynamicResource SasanCardBgBrush}" BorderBrush="{DynamicResource SasanCyanAccentBrush}" BorderThickness="1.5" CornerRadius="8" Padding="12" Margin="0,0,0,10"
                            Visibility="{Binding IsCustomerEditorOpen, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="{Binding CustomerEditorTitle}"
                                           FontSize="12" FontWeight="Black" Foreground="{DynamicResource SasanCyanAccentBrush}"/>
                                <Button Command="{Binding CloseCustomerEditorCommand}" Content="✕" HorizontalAlignment="Right" Width="24" Height="24" Background="Transparent" Foreground="{DynamicResource SasanSubTextBrush}" BorderThickness="0" Cursor="Hand"/>
                            </Grid>

                            <!-- Form fields grid -->
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="2*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Row 0: Name, Phone, Email -->
                                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,6">
                                    <TextBlock Text="Customer Full Name *:" FontSize="10" Foreground="{DynamicResource SasanSubTextBrush}"/>
                                    <TextBox Text="{Binding CustomerFormName, UpdateSourceTrigger=PropertyChanged}" Height="28" FontSize="11" Background="{DynamicResource SasanInputBgBrush}" Foreground="{DynamicResource SasanForegroundBrush}"/>
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,8,6">
                                    <TextBlock Text="Mobile / WhatsApp (10 digits) *:" FontSize="10" Foreground="{DynamicResource SasanSubTextBrush}"/>
                                    <TextBox Text="{Binding CustomerFormPhone, UpdateSourceTrigger=PropertyChanged}" Height="28" FontSize="11" Background="{DynamicResource SasanInputBgBrush}" Foreground="{DynamicResource SasanForegroundBrush}"/>
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,6">
                                    <TextBlock Text="Email Address (Optional):" FontSize="10" Foreground="{DynamicResource SasanSubTextBrush}"/>
                                    <TextBox Text="{Binding CustomerFormEmail, UpdateSourceTrigger=PropertyChanged}" Height="28" FontSize="11" Background="{DynamicResource SasanInputBgBrush}" Foreground="{DynamicResource SasanForegroundBrush}"/>
                                </StackPanel>

                                <!-- Row 1: GSTIN, City, Address -->
                                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,6">
                                    <TextBlock Text="GSTIN (For B2B Tax Invoice):" FontSize="10" Foreground="{DynamicResource SasanSubTextBrush}"/>
                                    <TextBox Text="{Binding CustomerFormGstin, UpdateSourceTrigger=PropertyChanged}" Height="28" FontSize="11" Background="{DynamicResource SasanInputBgBrush}" Foreground="{DynamicResource SasanForegroundBrush}"/>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,8,6">
                                    <TextBlock Text="City / Town:" FontSize="10" Foreground="{DynamicResource SasanSubTextBrush}"/>
                                    <TextBox Text="{Binding CustomerFormCity, UpdateSourceTrigger=PropertyChanged}" Height="28" FontSize="11" Background="{DynamicResource SasanInputBgBrush}" Foreground="{DynamicResource SasanForegroundBrush}"/>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,6">
                                    <TextBlock Text="Street Address:" FontSize="10" Foreground="{DynamicResource SasanSubTextBrush}"/>
                                    <TextBox Text="{Binding CustomerFormAddress, UpdateSourceTrigger=PropertyChanged}" Height="28" FontSize="11" Background="{DynamicResource SasanInputBgBrush}" Foreground="{DynamicResource SasanForegroundBrush}"/>
                                </StackPanel>

                                <!-- Row 2: State, Credit Limit, Action Buttons -->
                                <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="State &amp; State Code:" FontSize="10" Foreground="{DynamicResource SasanSubTextBrush}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*"/>
                                            <ColumnDefinition Width="1*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Text="{Binding CustomerFormState, UpdateSourceTrigger=PropertyChanged}" Height="28" FontSize="11" Margin="0,0,4,0" Background="{DynamicResource SasanInputBgBrush}" Foreground="{DynamicResource SasanForegroundBrush}"/>
                                        <TextBox Grid.Column="1" Text="{Binding CustomerFormStateCode, UpdateSourceTrigger=PropertyChanged}" Height="28" FontSize="11" Background="{DynamicResource SasanInputBgBrush}" Foreground="{DynamicResource SasanForegroundBrush}"/>
                                    </Grid>
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,0,8,0">
                                    <TextBlock Text="Aadhaar / ID Proof (Opt):" FontSize="10" Foreground="{DynamicResource SasanSubTextBrush}"/>
                                    <TextBox Text="{Binding CustomerFormAadhaar, UpdateSourceTrigger=PropertyChanged}" Height="28" FontSize="11" Background="{DynamicResource SasanInputBgBrush}" Foreground="{DynamicResource SasanForegroundBrush}"/>
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom" HorizontalAlignment="Right">
                                    <Button Command="{Binding CloseCustomerEditorCommand}" Content="CANCEL" Height="28" Padding="10,0" Margin="0,0,6,0" Background="{DynamicResource SasanBorderBrush}" Foreground="{DynamicResource SasanForegroundBrush}" Cursor="Hand"/>
                                    <Button Command="{Binding SaveCustomerCommand}" Content="💾 SAVE &amp; APPLY TO BILL" Height="28" Padding="12,0" Background="{DynamicResource SasanCyanAccentBrush}" Foreground="#08101E" FontWeight="Bold" FontSize="11" Cursor="Hand"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Row 3: Parked / Held Bills Queue Drawer (Collapsible) -->
                    <Border Grid.Row="3" Background="{DynamicResource SasanHeaderBgBrush}" BorderBrush="{DynamicResource SasanAmberAccentBrush}" BorderThickness="1.5" CornerRadius="8" Padding="10" Margin="0,0,0,10"
                            Visibility="{Binding IsHeldBillsDrawerOpen, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <Grid Margin="0,0,0,6">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⏸️ PARKED CUSTOMER BILLS (நிறுத்தி வைக்கப்பட்டுள்ள பில்கள்)" FontSize="11" FontWeight="Black" Foreground="{DynamicResource SasanAmberAccentBrush}"/>
                                    <TextBlock Text="{Binding HeldBills.Count, StringFormat=' ({0} in queue)'}" FontSize="11" Foreground="{DynamicResource SasanSubTextBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Button Command="{Binding ToggleHeldBillsDrawerCommand}" Content="✕" HorizontalAlignment="Right" Width="22" Height="22" Background="Transparent" Foreground="{DynamicResource SasanSubTextBrush}" BorderThickness="0" Cursor="Hand"/>
                            </Grid>

                            <ItemsControl ItemsSource="{Binding HeldBills}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource SasanCardBgBrush}" BorderBrush="{DynamicResource SasanBorderBrush}" BorderThickness="1" CornerRadius="5" Padding="8,4" Margin="0,0,0,4">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding DisplaySummary}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SasanForegroundBrush}"/>
                                                    <TextBlock Text="{Binding Customer.PhoneNumber, StringFormat='Customer Mobile: {0}'}" FontSize="10" Foreground="{DynamicResource SasanSubTextBrush}"/>
                                                </StackPanel>
                                                <Button Grid.Column="1" Command="{Binding DataContext.RecallHeldBillCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        Content="▶️ RESUME BILL" Height="26" Padding="10,0" Margin="6,0,0,0" Background="{DynamicResource SasanCyanAccentBrush}" Foreground="#08101E" FontWeight="Bold" FontSize="10" Cursor="Hand"/>
                                                <Button Grid.Column="2" Command="{Binding DataContext.DiscardHeldBillCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        Content="✕" ToolTip="Discard this parked bill" Height="26" Width="26" Margin="6,0,0,0" Background="#3D1A24" Foreground="#FF5252" Cursor="Hand"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Row 4: USB Barcode / Name Search Scanner Input Box -->
                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="TxtBarcode" Grid.Column="0"
                                 Text="{Binding BarcodeInput, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="14" FontWeight="SemiBold"
                                 Height="40" Padding="10,8"
                                 Background="{DynamicResource SasanInputBgBrush}" Foreground="{DynamicResource SasanCyanAccentBrush}"
                                 BorderBrush="{DynamicResource SasanCyanAccentBrush}" BorderThickness="1.5"
                                 KeyDown="TxtBarcode_KeyDown"/>

                        <Button Grid.Column="1" Command="{Binding ProcessBarcodeScanCommand}"
                                Content="ADD / SCAN" Height="40" Margin="8,0,0,0" Padding="14,0"
                                Background="{DynamicResource SasanCyanAccentBrush}" Foreground="#08101E" FontWeight="Bold" FontSize="12" Cursor="Hand"/>

                        <!-- Manual Item Drawer Toggle Button -->
                        <Button Grid.Column="2" Command="{Binding ToggleManualEntryCommand}"
                                Content="✍️ MANUAL ENTRY (F11)" Height="40" Margin="6,0,0,0" Padding="12,0"
                                Background="{DynamicResource SasanBorderBrush}" Foreground="{DynamicResource SasanForegroundBrush}" FontWeight="SemiBold" FontSize="11" Cursor="Hand"
                                ToolTip="Enter custom accessories, repairs, or unlisted items manually (F11)"/>
                    </Grid>

                    <!-- Row 5: Manual Custom Item Entry Panel (Collapsible) -->
                    <Border Grid.Row="5" Background="{DynamicResource SasanHeaderBgBrush}" BorderBrush="{DynamicResource SasanAmberAccentBrush}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,10,0,0"
                            Visibility="{Binding IsManualEntryVisible, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="✍️ MANUAL ITEM ENTRY (கையால் உள்ளிட்டல்)" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SasanAmberAccentBrush}" Margin="0,0,0,6"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3*" /> <!-- Name -->
                                    <ColumnDefinition Width="1.2*" /> <!-- Price -->
                                    <ColumnDefinition Width="0.8*" /> <!-- Qty -->
                                    <ColumnDefinition Width="1*" /> <!-- GST% -->
                                    <ColumnDefinition Width="1*" /> <!-- HSN -->
                                    <ColumnDefinition Width="2*" /> <!-- IMEI -->
                                    <ColumnDefinition Width="Auto" /> <!-- Add Button -->
                                </Grid.ColumnDefinitions>

                                <!-- Name -->
                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                    <TextBlock Text="Item / Service Name:" FontSize="10" Foreground="{DynamicResource SasanSubTextBrush}"/>
                                    <TextBox Text="{Binding ManualItemName, UpdateSourceTrigger=PropertyChanged}" Height="28" FontSize="11" Background="{DynamicResource SasanInputBgBrush}" Foreground="{DynamicResource SasanForegroundBrush}"/>
                                </StackPanel>

                                <!-- Price -->
                                <StackPanel Grid.Column="1" Margin="0,0,6,0">
                                    <TextBlock Text="Price (₹):" FontSize="10" Foreground="{DynamicResource SasanSubTextBrush}"/>
                                    <TextBox Text="{Binding ManualPrice, UpdateSourceTrigger=PropertyChanged}" Height="28" FontSize="11" Background="{DynamicResource SasanInputBgBrush}" Foreground="{DynamicResource SasanForegroundBrush}"/>
                                </StackPanel>

                                <!-- Qty -->
                                <StackPanel Grid.Column="2" Margin="0,0,6,0">
                                    <TextBlock Text="Qty:" FontSize="10" Foreground="{DynamicResource SasanSubTextBrush}"/>
                                    <TextBox Text="{Binding ManualQuantity, UpdateSourceTrigger=PropertyChanged}" Height="28" FontSize="11" Background="{DynamicResource SasanInputBgBrush}" Foreground="{DynamicResource SasanForegroundBrush}"/>
                                </StackPanel>

                                <!-- GST% -->
                                <StackPanel Grid.Column="3" Margin="0,0,6,0">
                                    <TextBlock Text="GST %:" FontSize="10" Foreground="{DynamicResource SasanSubTextBrush}"/>
                                    <TextBox Text="{Binding ManualGstPercent, UpdateSourceTrigger=PropertyChanged}" Height="28" FontSize="11" Background="{DynamicResource SasanInputBgBrush}" Foreground="{DynamicResource SasanForegroundBrush}"/>
                                </StackPanel>

                                <!-- HSN -->
                                <StackPanel Grid.Column="4" Margin="0,0,6,0">
                                    <TextBlock Text="HSN:" FontSize="10" Foreground="{DynamicResource SasanSubTextBrush}"/>
                                    <TextBox Text="{Binding ManualHsn, UpdateSourceTrigger=PropertyChanged}" Height="28" FontSize="11" Background="{DynamicResource SasanInputBgBrush}" Foreground="{DynamicResource SasanForegroundBrush}"/>
                                </StackPanel>

                                <!-- Optional IMEI -->
                                <StackPanel Grid.Column="5" Margin="0,0,6,0">
                                    <TextBlock Text="IMEI / S/N (Opt):" FontSize="10" Foreground="{DynamicResource SasanSubTextBrush}"/>
                                    <TextBox Text="{Binding ManualImei, UpdateSourceTrigger=PropertyChanged}" Height="28" FontSize="11" Background="{DynamicResource SasanInputBgBrush}" Foreground="{DynamicResource SasanForegroundBrush}"/>
                                </StackPanel>

                                <!-- Add Button -->
                                <Button Grid.Column="6" Command="{Binding AddManualItemCommand}"
                                        Content="➕ ADD TO CART" Height="28" Margin="0,15,0,0" Padding="12,0"
                                        Background="{DynamicResource SasanAmberAccentBrush}" Foreground="#08101E" FontWeight="Bold" FontSize="11" Cursor="Hand"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Cart Items Table -->
            <Border Grid.Row="1" Background="{DynamicResource SasanCardBgBrush}" BorderBrush="{DynamicResource SasanBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="4,0,0,8">
                        <TextBlock Text="CART ITEMS &amp; SERIALIZED DEVICES" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource SasanSubTextBrush}"/>
                        <TextBlock Text="{Binding CartItems.Count, StringFormat='{}{0} Items'}" FontSize="11" Foreground="{DynamicResource SasanCyanAccentBrush}" HorizontalAlignment="Right" FontWeight="Bold"/>
                    </Grid>

                    <ListView Grid.Row="1" ItemsSource="{Binding CartItems}" Background="Transparent" BorderThickness="0">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource SasanPrimaryBrush}" BorderBrush="{DynamicResource SasanBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Item Name & Details -->
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource SasanForegroundBrush}" />
                                                <!-- Margin Scheme Badge -->
                                                <Border Background="{DynamicResource SasanAmberAccentBrush}" CornerRadius="3" Padding="5,1" Margin="8,0,0,0"
                                                        Visibility="{Binding IsMarginScheme, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="RULE 32(5) MARGIN" FontSize="9" FontWeight="Bold" Foreground="#08101E"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding FormattedSpecs}" FontSize="11" Foreground="{DynamicResource SasanSubTextBrush}" Margin="0,2,0,0"/>
                                            <TextBlock Text="{Binding HsnCode, StringFormat='HSN: {0}'}" FontSize="10" Foreground="{DynamicResource SasanSubTextBrush}" Margin="0,1,0,0"/>
                                        </StackPanel>

                                        <!-- Qty & Unit Rate with + / - buttons -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <Button Command="{Binding DataContext.DecrementItemQuantityCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                        CommandParameter="{Binding}"
                                                        Content="-" Width="22" Height="22" FontSize="12" FontWeight="Bold" Padding="0" Margin="0,0,4,0"
                                                        Background="{DynamicResource SasanBorderBrush}" Foreground="{DynamicResource SasanForegroundBrush}" Cursor="Hand"
                                                        Visibility="{Binding CanAdjustQuantity, Converter={StaticResource BoolToVis}}"/>
                                                <TextBlock Text="{Binding Quantity, StringFormat='Qty: {0}'}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource SasanForegroundBrush}" VerticalAlignment="Center"/>
                                                <Button Command="{Binding DataContext.IncrementItemQuantityCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                        CommandParameter="{Binding}"
                                                        Content="+" Width="22" Height="22" FontSize="12" FontWeight="Bold" Padding="0" Margin="4,0,0,0"
                                                        Background="{DynamicResource SasanBorderBrush}" Foreground="{DynamicResource SasanForegroundBrush}" Cursor="Hand"
                                                        Visibility="{Binding CanAdjustQuantity, Converter={StaticResource BoolToVis}}"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding UnitPrice, StringFormat='Rate: ₹{0:N0}'}" FontSize="11" Foreground="{DynamicResource SasanSubTextBrush}" HorizontalAlignment="Right" Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <!-- Line Total -->
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="16,0">
                                            <TextBlock Text="{Binding LineTotal, StringFormat='₹{0:N2}'}" FontWeight="Black" FontSize="15" Foreground="{DynamicResource SasanCyanAccentBrush}" HorizontalAlignment="Right"/>
                                            <TextBlock Text="{Binding GstPercentage, StringFormat='GST: {0}%'}" FontSize="10" Foreground="{DynamicResource SasanSubTextBrush}" HorizontalAlignment="Right"/>
                                        </StackPanel>

                                        <!-- Actions: Print Sticker & Remove -->
                                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                                            <Button Command="{Binding DataContext.PrintBarcodeLabelCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                    CommandParameter="{Binding}"
                                                    Content="🏷️" ToolTip="Print Barcode Sticker"
                                                    Height="30" Width="32" Margin="0,0,4,0" Background="{DynamicResource SasanBorderBrush}" Foreground="{DynamicResource SasanAmberAccentBrush}" Cursor="Hand"/>

                                            <Button Command="{Binding DataContext.RemoveCartItemCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                    CommandParameter="{Binding}"
                                                    Content="✕" ToolTip="Remove from cart"
                                                    Height="30" Width="32" Background="#3D1A24" Foreground="#FF5252" Cursor="Hand"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>
        </Grid>

        <!-- RIGHT COLUMN: FINANCIAL SUMMARY & CHECKOUT -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /> <!-- Summary Totals Card -->
                <RowDefinition Height="*" />    <!-- Split Payment Tender -->
                <RowDefinition Height="Auto" /> <!-- Checkout & Preview Buttons -->
            </Grid.RowDefinitions>

            <!-- Tax & Financial Summary Card with Quick Preset Discount Bar -->
            <Border Grid.Row="0" Background="{DynamicResource SasanCardBgBrush}" BorderBrush="{DynamicResource SasanBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="TAX &amp; BILL SUMMARY" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource SasanSubTextBrush}" Margin="0,0,0,8"/>

                    <Grid Margin="0,2">
                        <TextBlock Text="Subtotal (Items):" FontSize="12" Foreground="{DynamicResource SasanSubTextBrush}"/>
                        <TextBlock Text="{Binding SubTotal, StringFormat='₹{0:N2}'}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource SasanForegroundBrush}" HorizontalAlignment="Right"/>
                    </Grid>

                    <!-- Quick Preset Discounts Bar -->
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,4">
                        <TextBlock Text="Discount: " FontSize="11" Foreground="{DynamicResource SasanSubTextBrush}" VerticalAlignment="Center"/>
                        <Button Command="{Binding ApplyPresetDiscountCommand}" CommandParameter="100" Content="₹100" Height="22" Padding="5,0" Margin="2,0" FontSize="10" Background="{DynamicResource SasanBorderBrush}" Foreground="{DynamicResource SasanForegroundBrush}" Cursor="Hand"/>
                        <Button Command="{Binding ApplyPresetDiscountCommand}" CommandParameter="500" Content="₹500" Height="22" Padding="5,0" Margin="2,0" FontSize="10" Background="{DynamicResource SasanBorderBrush}" Foreground="{DynamicResource SasanForegroundBrush}" Cursor="Hand"/>
                        <Button Command="{Binding ApplyPresetDiscountCommand}" CommandParameter="1000" Content="₹1k" Height="22" Padding="5,0" Margin="2,0" FontSize="10" Background="{DynamicResource SasanBorderBrush}" Foreground="{DynamicResource SasanForegroundBrush}" Cursor="Hand"/>
                        <Button Command="{Binding ApplyPresetDiscountCommand}" CommandParameter="5PCT" Content="5%" Height="22" Padding="5,0" Margin="2,0" FontSize="10" Background="{DynamicResource SasanBorderBrush}" Foreground="{DynamicResource SasanAmberAccentBrush}" Cursor="Hand"/>
                        <Button Command="{Binding ApplyPresetDiscountCommand}" CommandParameter="10PCT" Content="10%" Height="22" Padding="5,0" Margin="2,0" FontSize="10" Background="{DynamicResource SasanBorderBrush}" Foreground="{DynamicResource SasanAmberAccentBrush}" Cursor="Hand"/>
                        <Button Command="{Binding ApplyPresetDiscountCommand}" CommandParameter="RESET" Content="✕" Height="22" Padding="5,0" Margin="2,0" FontSize="10" Background="#3D1A24" Foreground="#FF5252" Cursor="Hand" ToolTip="Reset discount"/>
                    </StackPanel>

                    <Grid Margin="0,2">
                        <TextBlock Text="Custom Discount (₹):" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource SasanSubTextBrush}"/>
                        <TextBox Text="{Binding InvoiceDiscount, UpdateSourceTrigger=PropertyChanged}" Width="100" Height="24" HorizontalAlignment="Right" FontSize="11" Background="{DynamicResource SasanInputBgBrush}" Foreground="{DynamicResource SasanAmberAccentBrush}"/>
                    </Grid>

                    <Grid Margin="0,2">
                        <TextBlock Text="Standard Taxable Value:" FontSize="12" Foreground="{DynamicResource SasanSubTextBrush}"/>
                        <TextBlock Text="{Binding TotalTaxableValue, StringFormat='₹{0:N2}'}" FontSize="12" Foreground="{DynamicResource SasanForegroundBrush}" HorizontalAlignment="Right"/>
                    </Grid>

                    <Grid Margin="0,2">
                        <TextBlock Text="CGST (9%):" FontSize="12" Foreground="{DynamicResource SasanSubTextBrush}"/>
                        <TextBlock Text="{Binding TotalCGST, StringFormat='₹{0:N2}'}" FontSize="12" Foreground="{DynamicResource SasanForegroundBrush}" HorizontalAlignment="Right"/>
                    </Grid>

                    <Grid Margin="0,2">
                        <TextBlock Text="SGST (9%):" FontSize="12" Foreground="{DynamicResource SasanSubTextBrush}"/>
                        <TextBlock Text="{Binding TotalSGST, StringFormat='₹{0:N2}'}" FontSize="12" Foreground="{DynamicResource SasanForegroundBrush}" HorizontalAlignment="Right"/>
                    </Grid>

                    <!-- Margin Scheme GST Note -->
                    <Border Background="{DynamicResource SasanHeaderBgBrush}" BorderBrush="{DynamicResource SasanAmberAccentBrush}" BorderThickness="1" CornerRadius="4" Padding="6,3" Margin="0,4"
                            Visibility="{Binding HasMarginSchemeItems, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <TextBlock Text="Rule 32(5) Margin GST:" FontSize="11" Foreground="{DynamicResource SasanAmberAccentBrush}"/>
                            <TextBlock Text="{Binding TotalMarginTax, StringFormat='₹{0:N2}'}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SasanAmberAccentBrush}" HorizontalAlignment="Right"/>
                        </Grid>
                    </Border>

                    <Separator Background="{DynamicResource SasanBorderBrush}" Margin="0,6"/>

                    <!-- Grand Total Display -->
                    <Border Background="{DynamicResource SasanHeaderBgBrush}" CornerRadius="6" Padding="10,8">
                        <Grid>
                            <TextBlock Text="NET PAYABLE:" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource SasanSubTextBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding GrandTotal, StringFormat='₹{0:N0}'}" FontSize="24" FontWeight="Black" Foreground="{DynamicResource SasanCyanAccentBrush}" HorizontalAlignment="Right"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Multi-Tender Split Payment Box with 1-Click Fast Buttons -->
            <Border Grid.Row="1" Background="{DynamicResource SasanCardBgBrush}" BorderBrush="{DynamicResource SasanBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="PAYMENT SPLIT TENDER" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource SasanSubTextBrush}" Margin="0,0,0,8"/>

                        <!-- 1-Click Fast Tender Buttons -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Command="{Binding SetExactUpiCommand}" Content="⚡ UPI" Height="26" Margin="0,0,2,0" Background="#0C344E" Foreground="{DynamicResource SasanCyanAccentBrush}" BorderBrush="{DynamicResource SasanCyanAccentBrush}" BorderThickness="1" FontWeight="Bold" FontSize="10" Cursor="Hand" ToolTip="Set 100% tender to UPI"/>
                            <Button Grid.Column="1" Command="{Binding SetExactCashCommand}" Content="💵 CASH" Height="26" Margin="2,0,2,0" Background="#143424" Foreground="#4ADE80" BorderBrush="#4ADE80" BorderThickness="1" FontWeight="Bold" FontSize="10" Cursor="Hand" ToolTip="Set 100% tender to Cash"/>
                            <Button Grid.Column="2" Command="{Binding SetExactCardCommand}" Content="💳 CARD" Height="26" Margin="2,0,2,0" Background="{DynamicResource SasanBorderBrush}" Foreground="{DynamicResource SasanForegroundBrush}" FontWeight="Bold" FontSize="10" Cursor="Hand" ToolTip="Set 100% tender to Card POS Swipe"/>
                            <Button Grid.Column="3" Command="{Binding SetSplit5050Command}" Content="🔄 50/50" Height="26" Margin="2,0,2,0" Background="{DynamicResource SasanHeaderBgBrush}" Foreground="{DynamicResource SasanAmberAccentBrush}" BorderBrush="{DynamicResource SasanAmberAccentBrush}" BorderThickness="1" FontWeight="Bold" FontSize="10" Cursor="Hand" ToolTip="Split bill 50% Cash + 50% UPI"/>
                            <Button Grid.Column="4" Command="{Binding ClearTenderCommand}" Content="✕ CLEAR" Height="26" Margin="2,0,0,0" Background="#3D1A24" Foreground="#FF5252" FontWeight="Bold" FontSize="9" Cursor="Hand" ToolTip="Clear all payment tender inputs"/>
                        </Grid>

                        <Grid Margin="0,2">
                            <TextBlock Text="Cash (₹):" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource SasanSubTextBrush}"/>
                            <TextBox Text="{Binding CashTendered, UpdateSourceTrigger=PropertyChanged}" Width="140" Height="28" HorizontalAlignment="Right" Background="{DynamicResource SasanInputBgBrush}" Foreground="{DynamicResource SasanForegroundBrush}"/>
                        </Grid>

                        <Grid Margin="0,2">
                            <TextBlock Text="UPI / QR (₹):" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource SasanSubTextBrush}"/>
                            <TextBox Text="{Binding UpiTendered, UpdateSourceTrigger=PropertyChanged}" Width="140" Height="28" HorizontalAlignment="Right" Background="{DynamicResource SasanInputBgBrush}" Foreground="{DynamicResource SasanCyanAccentBrush}"/>
                        </Grid>

                        <Grid Margin="0,2">
                            <TextBlock Text="Card (POS Swipe ₹):" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource SasanSubTextBrush}"/>
                            <TextBox Text="{Binding CardTendered, UpdateSourceTrigger=PropertyChanged}" Width="140" Height="28" HorizontalAlignment="Right" Background="{DynamicResource SasanInputBgBrush}" Foreground="{DynamicResource SasanForegroundBrush}"/>
                        </Grid>

                        <Grid Margin="0,2">
                            <TextBlock Text="Exchange Deduction (₹):" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource SasanSubTextBrush}"/>
                            <TextBox Text="{Binding ExchangeTendered, UpdateSourceTrigger=PropertyChanged}" Width="140" Height="28" HorizontalAlignment="Right" Background="{DynamicResource SasanInputBgBrush}" Foreground="{DynamicResource SasanAmberAccentBrush}"/>
                        </Grid>

                        <Grid Margin="0,2">
                            <TextBlock Text="Finance / Bajaj EMI (₹):" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource SasanSubTextBrush}"/>
                            <TextBox Text="{Binding FinanceEmiTendered, UpdateSourceTrigger=PropertyChanged}" Width="140" Height="28" HorizontalAlignment="Right" Background="{DynamicResource SasanInputBgBrush}" Foreground="{DynamicResource SasanForegroundBrush}"/>
                        </Grid>

                        <Grid Margin="0,4">
                            <TextBlock Text="Txn Ref / Approval #:" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource SasanSubTextBrush}"/>
                            <TextBox Text="{Binding PaymentReference, UpdateSourceTrigger=PropertyChanged}" Width="140" Height="26" HorizontalAlignment="Right" Background="{DynamicResource SasanInputBgBrush}" Foreground="{DynamicResource SasanSubTextBrush}"/>
                        </Grid>

                        <!-- Live Tender Telemetry -->
                        <Border Background="{DynamicResource SasanHeaderBgBrush}" CornerRadius="4" Padding="8,4" Margin="0,6,0,0">
                            <Grid>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Total Paid: " FontSize="11" Foreground="{DynamicResource SasanSubTextBrush}"/>
                                    <TextBlock Text="{Binding TotalTendered, StringFormat='₹{0:N2}'}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SasanForegroundBrush}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBlock Text="Change Due: " FontSize="11" Foreground="{DynamicResource SasanSubTextBrush}"/>
                                    <TextBlock Text="{Binding BalanceChange, StringFormat='₹{0:N2}'}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SasanCyanAccentBrush}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Action Buttons: Print Bill, Preview Bill and New Bill -->
            <StackPanel Grid.Row="2">
                <Button Command="{Binding CheckoutAndPrintInvoiceCommand}"
                        Height="48" Background="{DynamicResource SasanCyanAccentBrush}" Foreground="#08101E"
                        FontSize="14" FontWeight="Black" Cursor="Hand" Margin="0,0,0,6">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⚡ [F12] COMPLETE &amp; PRINT INVOICE" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Command="{Binding PreviewInvoiceCommand}"
                            Height="36" Margin="0,0,4,0" Background="#1E3A8A" Foreground="#FFFFFF"
                            FontSize="12" FontWeight="Bold" Cursor="Hand" ToolTip="Preview vector PDF before completing payment (F5 / F10)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="👁️ [F5] PREVIEW PDF" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="1" Command="{Binding NewBillCommand}"
                            Height="36" Margin="4,0,0,0" Background="{DynamicResource SasanBorderBrush}" Foreground="{DynamicResource SasanForegroundBrush}"
                            FontSize="12" FontWeight="Bold" Cursor="Hand" ToolTip="Clear and start new bill (F2)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔄 [F2] NEW BILL" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
