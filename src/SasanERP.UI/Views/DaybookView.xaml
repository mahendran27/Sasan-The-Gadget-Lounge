<UserControl x:Class="SasanERP.UI.Views.DaybookView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1100">

    <Grid Margin="20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Title & Controls -->
            <RowDefinition Height="Auto"/> <!-- Debit/Credit Balance Bar -->
            <RowDefinition Height="*"/>    <!-- Vouchers Grid & Expense Form -->
            <RowDefinition Height="Auto"/> <!-- Status -->
        </Grid.RowDefinitions>

        <!-- 1. Header -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="GENERAL LEDGER, DAYBOOK &amp; CASHBOOK" FontSize="18" FontWeight="Black" Foreground="#FFFFFF"/>
                <TextBlock Text="ACID compliant double-entry financial ledger vouchers for sales, purchases, receipts, and showroom expenses" 
                           FontSize="12" Foreground="#8EA4C1" Margin="0,2,0,0"/>
            </StackPanel>
            <Button Grid.Column="1" Command="{Binding LoadDaybookCommand}" Background="#1C2D4A" Foreground="#00E5FF" 
                    Padding="12,6" BorderBrush="#00E5FF" BorderThickness="1" Cursor="Hand" FontWeight="Bold">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🔄 "/>
                    <TextBlock Text="Refresh Daybook"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- 2. Debit / Credit Summary Bar -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Total Debits -->
            <Border Grid.Column="0" Background="#132035" BorderBrush="#223656" BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,0,6,0">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="TOTAL DEBITS (DR)" FontSize="11" FontWeight="Bold" Foreground="#8FA3BF"/>
                        <TextBlock Text="{Binding TotalDebits, StringFormat='₹{0:N2}'}" FontSize="20" FontWeight="Black" Foreground="#66BB6A" Margin="0,4,0,0"/>
                    </StackPanel>
                    <TextBlock Text="📥" FontSize="18" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Total Credits -->
            <Border Grid.Column="1" Background="#132035" BorderBrush="#223656" BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="3,0,3,0">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="TOTAL CREDITS (CR)" FontSize="11" FontWeight="Bold" Foreground="#8FA3BF"/>
                        <TextBlock Text="{Binding TotalCredits, StringFormat='₹{0:N2}'}" FontSize="20" FontWeight="Black" Foreground="#00E5FF" Margin="0,4,0,0"/>
                    </StackPanel>
                    <TextBlock Text="📤" FontSize="18" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Ledger Balanced Status -->
            <Border Grid.Column="2" Background="#132035" BorderBrush="#223656" BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="6,0,0,0">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="LEDGER STATUS" FontSize="11" FontWeight="Bold" Foreground="#8FA3BF"/>
                        <TextBlock Text="BALANCED (ACID OK)" FontSize="18" FontWeight="Black" Foreground="#4CAF50" Margin="0,4,0,0"/>
                    </StackPanel>
                    <TextBlock Text="⚖️" FontSize="18" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>

        <!-- 3. Vouchers DataGrid & Quick Expense Form -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="7*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <!-- Vouchers Table -->
            <Border Grid.Column="0" Background="#132035" BorderBrush="#223656" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,8,0">
                <DataGrid ItemsSource="{Binding Vouchers}" AutoGenerateColumns="False" CanUserAddRows="False"
                          IsReadOnly="True" Background="Transparent" BorderThickness="0" HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#1C2D4A" Foreground="#FFFFFF" RowHeight="32"
                          EnableRowVirtualization="True"
                          VirtualizingStackPanel.IsVirtualizing="True"
                          VirtualizingStackPanel.VirtualizationMode="Recycling"
                          AlternatingRowBackground="#0E192D">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="VOUCHER NO" Binding="{Binding VoucherNumber}" FontWeight="Bold" Width="130"/>
                        <DataGridTextColumn Header="ACCOUNT" Binding="{Binding AccountName}" Width="160"/>
                        <DataGridTextColumn Header="TYPE" Binding="{Binding EntryType}" Width="65"/>
                        <DataGridTextColumn Header="DEBIT (₹)" Binding="{Binding DebitAmount, StringFormat='₹{0:N2}'}" FontWeight="Bold" Foreground="#66BB6A" Width="95"/>
                        <DataGridTextColumn Header="CREDIT (₹)" Binding="{Binding CreditAmount, StringFormat='₹{0:N2}'}" FontWeight="Bold" Foreground="#00E5FF" Width="95"/>
                        <DataGridTextColumn Header="NARRATION" Binding="{Binding Narration}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- Fast Expense Form -->
            <Border Grid.Column="1" Background="#132035" BorderBrush="#223656" BorderThickness="1" CornerRadius="8" Padding="14" Margin="8,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="RECORD SHOP EXPENSE" FontSize="13" FontWeight="Bold" Foreground="#FF9100" Margin="0,0,0,12"/>

                        <!-- Category -->
                        <TextBlock Text="Expense Category:" FontSize="11" Foreground="#8FA3BF" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding ExpenseCategories}" SelectedItem="{Binding ExpenseCategory}" Height="32" Margin="0,0,0,10"/>

                        <!-- Amount -->
                        <TextBlock Text="Amount (₹):" FontSize="11" Foreground="#8FA3BF" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding ExpenseAmount, UpdateSourceTrigger=PropertyChanged}" Height="34" FontSize="14" FontWeight="Bold" 
                                 Background="#0A1424" Foreground="#00E5FF" BorderBrush="#00E5FF" BorderThickness="1" Margin="0,0,0,10"/>

                        <!-- Paid To -->
                        <TextBlock Text="Paid To / Vendor:" FontSize="11" Foreground="#8FA3BF" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding ExpensePaidTo, UpdateSourceTrigger=PropertyChanged}" Height="32" 
                                 Background="#0A1424" Foreground="#FFFFFF" BorderBrush="#223656" BorderThickness="1" Margin="0,0,0,10"/>

                        <!-- Payment Mode -->
                        <TextBlock Text="Payment Tender:" FontSize="11" Foreground="#8FA3BF" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding PaymentModes}" SelectedItem="{Binding ExpensePaymentMode}" Height="32" Margin="0,0,0,10"/>

                        <!-- Description -->
                        <TextBlock Text="Notes / Voucher Narration:" FontSize="11" Foreground="#8FA3BF" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding ExpenseDescription, UpdateSourceTrigger=PropertyChanged}" Height="50" TextWrapping="Wrap"
                                 Background="#0A1424" Foreground="#FFFFFF" BorderBrush="#223656" BorderThickness="1" Margin="0,0,0,14"/>

                        <!-- Post Expense Button -->
                        <Button Command="{Binding RecordExpenseCommand}" Height="40" Background="#FF9100" Foreground="#08101E" 
                                FontWeight="Black" Cursor="Hand">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📝 "/>
                                <TextBlock Text="Post &amp; Balance in Ledger"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- 4. Status Bar -->
        <Border Grid.Row="3" Background="#0C182B" BorderBrush="#1C2D4A" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,10,0,0">
            <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="#8EA4C1"/>
        </Border>
    </Grid>
</UserControl>
