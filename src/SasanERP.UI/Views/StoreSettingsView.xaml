<UserControl x:Class="SasanERP.UI.Views.StoreSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1100">

    <Grid Margin="16,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Header -->
            <RowDefinition Height="*" />    <!-- Form Tabs / Workspace -->
            <RowDefinition Height="Auto" /> <!-- Footer Buttons -->
        </Grid.RowDefinitions>

        <!-- 1. HEADER -->
        <Border Grid.Row="0" Background="#111D36" BorderBrush="#1E2F52" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="STORE PROFILE &amp; INVOICE SETTINGS" FontWeight="Black" FontSize="16" Foreground="#00E5FF"/>
                        <Border Background="#FF9100" CornerRadius="4" Padding="6,1" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="THENI OUTLET" FontSize="10" FontWeight="Bold" Foreground="#08101E"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Edit shop address, GSTIN, bank accounts, logo, and customize 10+ A4 invoice printing templates" 
                               FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding ResetToDefaultTheniAddressCommand}" 
                            Background="#1E293B" BorderBrush="#475569" BorderThickness="1" Padding="10,6" Margin="0,0,8,0" Cursor="Hand">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔄 " FontSize="12"/>
                            <TextBlock Text="Reset Theni Default" FontSize="11" Foreground="#E2E8F0"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. TABBED SETTINGS WORKSPACE -->
        <TabControl Grid.Row="1" Background="#111D36" BorderBrush="#1E2F52">
            
            <!-- TAB 1: STORE ADDRESS & CONTACT -->
            <TabItem Header="📍 Store Address &amp; Contact">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="6.5*" />
                            <ColumnDefinition Width="3.5*" />
                        </Grid.ColumnDefinitions>

                        <!-- Left Column: Address Fields -->
                        <StackPanel Grid.Column="0" Margin="0,0,14,0">
                            <TextBlock Text="SHOP IDENTITY &amp; LEGAL NAME" FontSize="12" FontWeight="Bold" Foreground="#00E5FF" Margin="0,0,0,8"/>
                            
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="6*" />
                                    <ColumnDefinition Width="4*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                    <TextBlock Text="Business Name (வணிகப் பெயர்):" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,3"/>
                                    <TextBox Text="{Binding BusinessName, UpdateSourceTrigger=PropertyChanged}" Height="32" FontWeight="Bold"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                    <TextBlock Text="Tagline / Subtitle:" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,3"/>
                                    <TextBox Text="{Binding Tagline, UpdateSourceTrigger=PropertyChanged}" Height="32"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="PHYSICAL STORE ADDRESS (கடை முகவரி)" FontSize="12" FontWeight="Bold" Foreground="#FF9100" Margin="0,10,0,8"/>
                            
                            <StackPanel Margin="0,0,0,8">
                                <TextBlock Text="Door No, Building, Street (கதவு எண், கட்டிடம், தெரு):" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,3"/>
                                <TextBox Text="{Binding AddressLine1, UpdateSourceTrigger=PropertyChanged}" Height="32"/>
                            </StackPanel>

                            <StackPanel Margin="0,0,0,8">
                                <TextBlock Text="Area, Colony, Landmark (பகுதி, காலனி, அடையாளம்):" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,3"/>
                                <TextBox Text="{Binding AddressLine2, UpdateSourceTrigger=PropertyChanged}" Height="32"/>
                            </StackPanel>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                    <TextBlock Text="City / Town (நகரம்):" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,3"/>
                                    <TextBox Text="{Binding City, UpdateSourceTrigger=PropertyChanged}" Height="32"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="4,0,4,0">
                                    <TextBlock Text="State (மாநிலம்):" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,3"/>
                                    <TextBox Text="{Binding State, UpdateSourceTrigger=PropertyChanged}" Height="32"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="4,0,0,0">
                                    <TextBlock Text="Pincode (அஞ்சல் குறியீடு):" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,3"/>
                                    <TextBox Text="{Binding Pincode, UpdateSourceTrigger=PropertyChanged}" Height="32"/>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                    <TextBlock Text="Phone Number (தொலைபேசி):" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,3"/>
                                    <TextBox Text="{Binding PhoneNumber, UpdateSourceTrigger=PropertyChanged}" Height="32" FontWeight="Bold"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="4,0,4,0">
                                    <TextBlock Text="Email Address:" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,3"/>
                                    <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Height="32"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="4,0,0,0">
                                    <TextBlock Text="State Code (GST):" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,3"/>
                                    <TextBox Text="{Binding StateCode, UpdateSourceTrigger=PropertyChanged}" Height="32" FontWeight="Bold"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <!-- Right Column: Logo Box & Live Preview -->
                        <Border Grid.Column="1" Background="#162544" BorderBrush="#22365D" BorderThickness="1" CornerRadius="8" Padding="14">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="SHOP LOGO (லோகோ)" FontSize="12" FontWeight="Bold" Foreground="#00E5FF" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                                
                                <Border Background="#08101E" BorderBrush="#00E5FF" BorderThickness="2" CornerRadius="80" Width="140" Height="140" Margin="0,0,0,12">
                                    <Image Source="pack://application:,,,/Assets/logo.png" Width="130" Height="130" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Border>

                                <TextBlock Text="Current Logo: Sasan Badge" FontSize="11" FontWeight="Bold" Foreground="#F8FAFC" HorizontalAlignment="Center"/>
                                <TextBlock Text="Cyan &amp; Amber Circular Emblem" FontSize="10" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,2,0,10"/>

                                <Button Command="{Binding BrowseLogoFileCommand}" 
                                        Background="#1E3A8A" BorderBrush="#3B82F6" BorderThickness="1" Padding="12,6" Cursor="Hand" HorizontalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📁 " FontSize="12"/>
                                        <TextBlock Text="Change Logo (லோகோ மாற்று)" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF"/>
                                    </StackPanel>
                                </Button>

                                <TextBlock Text="Supports PNG, JPG, JPEG. Automatically renders on all 10+ invoice templates!" 
                                           FontSize="9.5" Foreground="#64748B" TextWrapping="Wrap" TextAlignment="Center" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 2: GST & BANKING MANDATE -->
            <TabItem Header="⚖️ GST &amp; Banking Mandate">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14">
                    <StackPanel MaxWidth="800" HorizontalAlignment="Left">
                        <TextBlock Text="INDIAN GST TAX REGISTRATION" FontSize="12" FontWeight="Bold" Foreground="#00E5FF" Margin="0,0,0,10"/>
                        
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="Store GSTIN (ஜிஎஸ்டி பதிவு எண்):" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding Gstin, UpdateSourceTrigger=PropertyChanged}" Height="34" FontWeight="Bold" Foreground="#38BDF8"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock Text="Invoice Bill Prefix (எ.கா: SGL):" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding InvoicePrefix, UpdateSourceTrigger=PropertyChanged}" Height="34" FontWeight="Bold"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="BANK ACCOUNT DETAILS (FOR INVOICE NEFT/RTGS)" FontSize="12" FontWeight="Bold" Foreground="#FF9100" Margin="0,10,0,10"/>
                        
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="Bank Name (வங்கி பெயர்):" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding BankName, UpdateSourceTrigger=PropertyChanged}" Height="32"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock Text="Bank Branch (கிளை):" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding BankBranch, UpdateSourceTrigger=PropertyChanged}" Height="32"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="Account Number (கணக்கு எண்):" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding BankAccountNumber, UpdateSourceTrigger=PropertyChanged}" Height="32" FontWeight="Bold"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock Text="IFSC Code (ஐஎஃப்எஸ்சி):" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding BankIFSC, UpdateSourceTrigger=PropertyChanged}" Height="32" FontWeight="Bold"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="DYNAMIC UPI PAYMENT QR CODE" FontSize="12" FontWeight="Bold" Foreground="#10B981" Margin="0,10,0,6"/>
                        <StackPanel Margin="0,0,0,8">
                            <TextBlock Text="UPI VPA ID (எ.கா: 9080803070@sbi அல்லது 9080803070@upi):" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding UpiId, UpdateSourceTrigger=PropertyChanged}" Height="34" FontWeight="Bold" Foreground="#34D399"/>
                            <TextBlock Text="Every printed invoice dynamically generates a vector QR code with this VPA for instant customer payment." 
                                       FontSize="10" Foreground="#64748B" Margin="0,4,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 3: INVOICE PRINTING & DESIGN PREFERENCES -->
            <TabItem Header="🖨️ Invoice Templates &amp; Print Mode">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14">
                    <StackPanel MaxWidth="800" HorizontalAlignment="Left">
                        <TextBlock Text="DEFAULT INVOICE DESIGN SELECTION (10+ A4 STYLES)" FontSize="12" FontWeight="Bold" Foreground="#00E5FF" Margin="0,0,0,10"/>

                        <StackPanel Margin="0,0,0,14">
                            <TextBlock Text="Choose Default Invoice Template Style:" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,4"/>
                            <ComboBox ItemsSource="{Binding AvailableTemplates}" SelectedItem="{Binding DefaultInvoiceTemplate}" Height="34" FontSize="12" FontWeight="Bold"/>
                            <TextBlock Text="Styles 1-10 are dedicated A4 designs. Every template includes full shop details, serialized IMEI telemetry, split payment, and UPI QR code."
                                       FontSize="10" Foreground="#64748B" Margin="0,4,0,0"/>
                        </StackPanel>

                        <TextBlock Text="COLOR VS. BLACK &amp; WHITE LASER PRINTING MODE" FontSize="12" FontWeight="Bold" Foreground="#FF9100" Margin="0,10,0,8"/>
                        
                        <Border Background="#162544" BorderBrush="#22365D" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Black &amp; White (Monochrome) Laser Printer Optimization:" FontSize="11.5" FontWeight="Bold" Foreground="#F8FAFC"/>
                                    <TextBlock Text="When enabled, all invoices render with pure black lines, high-contrast monochrome logo, and shaded grayscale bars. Perfect for HP, Canon, Brother monochrome lasers."
                                               FontSize="10" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                </StackPanel>
                                <CheckBox Grid.Column="1" IsChecked="{Binding IsMonochromePrintMode}" VerticalAlignment="Center" Margin="10,0,0,0">
                                    <TextBlock Text="Force B&amp;W Mode" FontSize="11" FontWeight="Bold"/>
                                </CheckBox>
                            </Grid>
                        </Border>

                        <TextBlock Text="TERMS &amp; CONDITIONS / WARRANTY POLICY (பிரிண்ட் செய்யப்படும் விதிமுறைகள்)" FontSize="12" FontWeight="Bold" Foreground="#00E5FF" Margin="0,6,0,6"/>
                        <TextBox Text="{Binding TermsAndConditions, UpdateSourceTrigger=PropertyChanged}" 
                                 AcceptsReturn="True" Height="100" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontSize="10.5"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 4: SYSTEM HEALTH & BACKUP VAULT -->
            <TabItem Header="🛡️ Health &amp; Backups">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14">
                    <StackPanel MaxWidth="800" HorizontalAlignment="Left">
                        <TextBlock Text="DATABASE INTEGRITY &amp; AUTOMATED BACKUP VAULT" FontSize="12" FontWeight="Bold" Foreground="#00E5FF" Margin="0,0,0,10"/>

                        <!-- Engine Status Card -->
                        <Border Background="#162544" BorderBrush="#22365D" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="STORAGE &amp; DATABASE ENGINE" FontSize="11" FontWeight="Bold" Foreground="#8EA4C1"/>
                                    <TextBlock Text="{Binding SqliteEngineStatus}" FontSize="14" FontWeight="Black" Foreground="#4ADE80" Margin="0,4,0,2"/>
                                    <TextBlock Text="{Binding DatabasePath, StringFormat='Path: {0}'}" FontSize="10.5" Foreground="#94A3B8" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding DatabaseSizeFormatted, StringFormat='Active Database Size: {0}'}" FontSize="11" FontWeight="SemiBold" Foreground="#F8FAFC" Margin="0,4,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="1" Command="{Binding CreateInstantBackupCommand}"
                                        Background="#00E5FF" BorderThickness="0" Padding="14,8" Cursor="Hand" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="💾 " FontSize="13"/>
                                        <TextBlock Text="Create Instant Backup" FontSize="12" FontWeight="Black" Foreground="#08101E"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Backup Telemetry -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="#111E38" BorderBrush="#1C2E52" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,6,0">
                                <StackPanel>
                                    <TextBlock Text="TOTAL LOCAL BACKUPS" FontSize="10.5" FontWeight="Bold" Foreground="#8EA4C1"/>
                                    <TextBlock Text="{Binding TotalBackupsCount, StringFormat='{}{0} Snapshots'}" FontSize="18" FontWeight="Black" Foreground="#38BDF8" Margin="0,4,0,0"/>
                                    <TextBlock Text="Retains rolling 30 daily backups with auto-rotation" FontSize="9.5" Foreground="#64748B" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Background="#111E38" BorderBrush="#1C2E52" BorderThickness="1" CornerRadius="8" Padding="12" Margin="6,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="LATEST BACKUP CREATED" FontSize="10.5" FontWeight="Bold" Foreground="#8EA4C1"/>
                                    <TextBlock Text="{Binding LatestBackupTimestamp}" FontSize="14" FontWeight="Bold" Foreground="#FBBF24" Margin="0,4,0,0"/>
                                    <TextBlock Text="Flushes WAL pages to primary DB prior to snapshot" FontSize="9.5" Foreground="#64748B" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- ACID Ledger Guard Details -->
                        <Border Background="#0C172B" BorderBrush="#1D3054" BorderThickness="1" CornerRadius="8" Padding="12">
                            <StackPanel>
                                <TextBlock Text="FINANCIAL ACID INVARIANT SECURITY" FontSize="11" FontWeight="Bold" Foreground="#10B981" Margin="0,0,0,4"/>
                                <TextBlock Text="Every sales invoice, buyback voucher, and split-tender payment strictly requires Debit = Credit before database commit. Zero rounding drift allowed." 
                                           FontSize="10.5" Foreground="#94A3B8" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- 3. FOOTER ACTIONS -->
        <Border Grid.Row="2" Background="#08101E" BorderBrush="#1C2D4A" BorderThickness="0,1,0,0" Padding="12,10" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" FontSize="12" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center"/>

                <Button Grid.Column="1" Command="{Binding SaveCompanyProfileCommand}" Background="#00E5FF" BorderThickness="0" Padding="18,6" Cursor="Hand">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="💾 " FontSize="12"/>
                        <TextBlock Text="Save Changes (சேமித்துக்கொள்)" FontSize="12" FontWeight="Black" Foreground="#08101E"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>
