<ui:FluentWindow x:Class="SasanERP.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:vm="clr-namespace:SasanERP.UI.ViewModels"
        xmlns:views="clr-namespace:SasanERP.UI.Views"
        Title="Sasan The Gadget Lounge - Commercial Enterprise ERP, POS &amp; Inventory Suite"
        Height="840" Width="1380"
        MinHeight="720" MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        Background="#0A111E"
        Foreground="#E0E6ED"
        KeyDown="Window_KeyDown">

    <ui:FluentWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- View DataTemplates for In-Place Dynamic Module Navigation -->
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PosViewModel}">
            <views:PosView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:InventoryViewModel}">
            <views:InventoryView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:InventoryIntakeViewModel}">
            <views:DeviceIntakeView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DaybookViewModel}">
            <views:DaybookView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:GstReportsViewModel}">
            <views:GstReportsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:WirelessStudioViewModel}">
            <views:WirelessStudioView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CompanySettingsViewModel}">
            <views:StoreSettingsView />
        </DataTemplate>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Top Header Bar -->
            <RowDefinition Height="*" />    <!-- Main Shell (Left Nav Rail + Workspace) -->
            <RowDefinition Height="Auto" /> <!-- Bottom Status Bar -->
        </Grid.RowDefinitions>

        <!-- ============================================================== -->
        <!-- 1. TOP HEADER & STORE IDENTITY BAR                             -->
        <!-- ============================================================== -->
        <Border Grid.Row="0" Background="#070E1A" BorderBrush="#1C2D4A" BorderThickness="0,0,0,1" Padding="16,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Store Brand & Logo -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#08101E" BorderBrush="#00E5FF" BorderThickness="1.5" CornerRadius="22" Width="44" Height="44" Margin="0,0,12,0" ClipToBounds="True">
                        <Image Source="pack://application:,,,/Assets/logo.png" Width="40" Height="40" HorizontalAlignment="Center" VerticalAlignment="Center"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding StoreName}" FontWeight="Black" FontSize="17" Foreground="#FFFFFF" />
                            <Border Background="#FF9100" CornerRadius="4" Padding="6,1" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="THENI OUTLET" FontSize="10" FontWeight="Bold" Foreground="#08101E"/>
                            </Border>
                            <Border Background="#16253D" CornerRadius="4" Padding="8,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="GSTIN: 33AAECS4821N1ZH" FontSize="10" FontWeight="Bold" Foreground="#00E5FF"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding StoreAddress}" FontSize="11" Foreground="#8FA3BF" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Center Active Module Indicator -->
                <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Background="#132035" BorderBrush="#223656" BorderThickness="1" CornerRadius="6" Padding="16,4">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="ACTIVE MODULE: " FontSize="11" FontWeight="Bold" Foreground="#8FA3BF"/>
                            <TextBlock Text="{Binding CurrentSection}" FontSize="12" FontWeight="Black" Foreground="#00E5FF"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Top Right Quick Controls -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Cashier Badge -->
                    <Border Background="#16253D" CornerRadius="6" Padding="10,5" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="👤 " FontSize="12"/>
                            <TextBlock Text="{Binding ActiveCashier}" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF"/>
                        </StackPanel>
                    </Border>

                    <!-- Theme Selector -->
                    <Border Background="#16253D" CornerRadius="6" Padding="6,2" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🎨" FontSize="12" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <ComboBox ItemsSource="{Binding PosVM.AvailableThemeModes}" SelectedItem="{Binding PosVM.SelectedThemeMode}" Width="140" Height="26" FontSize="11" />
                        </StackPanel>
                    </Border>

                    <!-- Invoice Template Selector -->
                    <Border Background="#16253D" CornerRadius="6" Padding="6,2">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="📄" FontSize="12" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <ComboBox ItemsSource="{Binding PosVM.AvailableInvoiceTemplates}" SelectedItem="{Binding PosVM.SelectedInvoiceTemplate}" Width="160" Height="26" FontSize="11" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================================================== -->
        <!-- 2. MAIN SHELL (NAVIGATION RAIL + DYNAMIC WORKSPACE)            -->
        <!-- ============================================================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" /> <!-- Left Navigation Sidebar -->
                <ColumnDefinition Width="*" />   <!-- Dynamic Module View Workspace -->
            </Grid.ColumnDefinitions>

            <!-- LEFT NAVIGATION RAIL -->
            <Border Grid.Column="0" Background="#070E1A" BorderBrush="#1C2D4A" BorderThickness="0,0,1,0" Padding="8,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />    <!-- Navigation Items -->
                        <RowDefinition Height="Auto" /> <!-- Bottom Action Buttons -->
                    </Grid.RowDefinitions>

                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- Section Title -->
                            <TextBlock Text="ERP MODULES" FontSize="10" FontWeight="Black" Foreground="#64748B" Margin="10,4,0,8"/>

                            <!-- Nav Item 1: Dashboard [F1] -->
                            <Button Click="BtnNavDashboard_Click" HorizontalContentAlignment="Left" Padding="12,10" Margin="0,0,0,4"
                                    BorderThickness="0" Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentSection}" Value="Dashboard">
                                                <Setter Property="Background" Value="#162744"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <Grid Width="170">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📊 " FontSize="14" Margin="0,0,8,0"/>
                                        <TextBlock Text="Dashboard" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF"/>
                                    </StackPanel>
                                    <TextBlock Text="[F1]" FontSize="10" FontWeight="Bold" Foreground="#00E5FF" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </Button>

                            <!-- Nav Item 2: POS Billing [F2] -->
                            <Button Click="BtnNavPos_Click" HorizontalContentAlignment="Left" Padding="12,10" Margin="0,0,0,4"
                                    BorderThickness="0" Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentSection}" Value="PosBilling">
                                                <Setter Property="Background" Value="#162744"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <Grid Width="170">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="⚡ " FontSize="14" Margin="0,0,8,0"/>
                                        <TextBlock Text="POS Billing" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF"/>
                                    </StackPanel>
                                    <TextBlock Text="[F2]" FontSize="10" FontWeight="Bold" Foreground="#00E5FF" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </Button>

                            <!-- Nav Item 3: Inventory & IMEI Registry [F3] -->
                            <Button Click="BtnNavInventory_Click" HorizontalContentAlignment="Left" Padding="12,10" Margin="0,0,0,4"
                                    BorderThickness="0" Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentSection}" Value="InventoryRegistry">
                                                <Setter Property="Background" Value="#162744"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <Grid Width="170">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📦 " FontSize="14" Margin="0,0,8,0"/>
                                        <TextBlock Text="Stock Registry" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF"/>
                                    </StackPanel>
                                    <TextBlock Text="[F3]" FontSize="10" FontWeight="Bold" Foreground="#00E5FF" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </Button>

                            <!-- Nav Item 4: Intake & Barcode Stickers [F4] -->
                            <Button Click="BtnNavIntake_Click" HorizontalContentAlignment="Left" Padding="12,10" Margin="0,0,0,4"
                                    BorderThickness="0" Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentSection}" Value="DeviceIntake">
                                                <Setter Property="Background" Value="#162744"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <Grid Width="170">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🏷️ " FontSize="14" Margin="0,0,8,0"/>
                                        <TextBlock Text="Intake &amp; Stickers" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF"/>
                                    </StackPanel>
                                    <TextBlock Text="[F4]" FontSize="10" FontWeight="Bold" Foreground="#FF9100" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </Button>

                            <!-- Nav Item 5: Daybook & Accounts [F6] -->
                            <Button Click="BtnNavDaybook_Click" HorizontalContentAlignment="Left" Padding="12,10" Margin="0,0,0,4"
                                    BorderThickness="0" Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentSection}" Value="DaybookLedger">
                                                <Setter Property="Background" Value="#162744"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <Grid Width="170">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📒 " FontSize="14" Margin="0,0,8,0"/>
                                        <TextBlock Text="Daybook &amp; Ledgers" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF"/>
                                    </StackPanel>
                                    <TextBlock Text="[F6]" FontSize="10" FontWeight="Bold" Foreground="#00E5FF" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </Button>

                            <!-- Nav Item 6: GST & GSTR-1 Hub [F7] -->
                            <Button Click="BtnNavGstReports_Click" HorizontalContentAlignment="Left" Padding="12,10" Margin="0,0,0,4"
                                    BorderThickness="0" Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentSection}" Value="GstReports">
                                                <Setter Property="Background" Value="#162744"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <Grid Width="170">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📈 " FontSize="14" Margin="0,0,8,0"/>
                                        <TextBlock Text="GST &amp; GSTR-1 Hub" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF"/>
                                    </StackPanel>
                                    <TextBlock Text="[F7]" FontSize="10" FontWeight="Bold" Foreground="#00E5FF" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </Button>

                            <!-- Nav Item 7: NFC & UHF RFID Wireless Hub [F8] -->
                            <Button Click="BtnNavWireless_Click" HorizontalContentAlignment="Left" Padding="12,10" Margin="0,0,0,4"
                                    BorderThickness="0" Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentSection}" Value="WirelessStudio">
                                                <Setter Property="Background" Value="#162744"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <Grid Width="170">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📡 " FontSize="14" Margin="0,0,8,0"/>
                                        <TextBlock Text="NFC &amp; UHF RFID" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF"/>
                                    </StackPanel>
                                    <TextBlock Text="[F8]" FontSize="10" FontWeight="Bold" Foreground="#38BDF8" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </Button>

                            <!-- Nav Item 8: Store Settings & Profile [F5] -->
                            <Button Click="BtnNavSettings_Click" HorizontalContentAlignment="Left" Padding="12,10" Margin="0,0,0,4"
                                    BorderThickness="0" Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentSection}" Value="StoreSettings">
                                                <Setter Property="Background" Value="#162744"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <Grid Width="170">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="⚙️ " FontSize="14" Margin="0,0,8,0"/>
                                        <TextBlock Text="Store Settings" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF"/>
                                    </StackPanel>
                                    <TextBlock Text="[F5]" FontSize="10" FontWeight="Bold" Foreground="#C084FC" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Bottom Quick POS Checkout Helper -->
                    <Border Grid.Row="1" Background="#132035" BorderBrush="#223656" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,8,0,0">
                        <StackPanel>
                            <TextBlock Text="QUICK BILLING ACTION" FontSize="10" FontWeight="Bold" Foreground="#8FA3BF" Margin="0,0,0,6"/>
                            <Button Command="{Binding PosVM.NewBillCommand}" Background="#1E3A8A" Foreground="#FFFFFF" 
                                    Height="32" FontWeight="Bold" FontSize="11" Margin="0,0,0,4" Cursor="Hand">
                                <TextBlock Text="➕ [F2] Fresh Invoice"/>
                            </Button>
                            <Button Command="{Binding PosVM.CheckoutAndPrintInvoiceCommand}" Background="#00E5FF" Foreground="#08101E" 
                                    Height="36" FontWeight="Black" FontSize="11" Cursor="Hand">
                                <TextBlock Text="⚡ [F9] Save &amp; Print"/>
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- DYNAMIC MODULE VIEW WORKSPACE -->
            <ContentControl Grid.Column="1" Content="{Binding CurrentViewModel}" Background="#0A111E"/>
        </Grid>

        <!-- ============================================================== -->
        <!-- 3. BOTTOM GLOBAL STATUS BAR                                    -->
        <!-- ============================================================== -->
        <Border Grid.Row="2" Background="#070E1A" BorderBrush="#1C2D4A" BorderThickness="0,1,0,0" Padding="16,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{Binding GlobalStatus}" FontSize="12" Foreground="#8EA4C1" VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding CurrentTimeString}" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,14,0"/>
                    <TextBlock Text="Standalone Offline Engine Active • Sasan Terminal #1 (Theni)" FontSize="11" Foreground="#4CAF50"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
