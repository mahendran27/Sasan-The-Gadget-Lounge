<ui:FluentWindow x:Class="SasanERP.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:vm="clr-namespace:SasanERP.UI.ViewModels"
        Title="Sasan The Gadget Lounge - Enterprise POS &amp; Inventory System"
        Height="800" Width="1280"
        MinHeight="720" MinWidth="1024"
        WindowStartupLocation="CenterScreen"
        Background="#0E1626"
        Foreground="#E0E6ED"
        KeyDown="Window_KeyDown">

    <ui:FluentWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Top Bar -->
            <RowDefinition Height="Auto" /> <!-- Shortcut Bar -->
            <RowDefinition Height="*" />    <!-- POS Workspace -->
            <RowDefinition Height="Auto" /> <!-- Status Bar -->
        </Grid.RowDefinitions>

        <!-- 1. TOP HEADER & BRANDING -->
        <Border Grid.Row="0" Background="#08101E" BorderBrush="#1C2D4A" BorderThickness="0,0,0,1" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#08101E" BorderBrush="#00E5FF" BorderThickness="1.5" CornerRadius="22" Width="44" Height="44" Margin="0,0,12,0" ClipToBounds="True">
                        <Image Source="pack://application:,,,/Assets/logo.png" Width="40" Height="40" HorizontalAlignment="Center" VerticalAlignment="Center"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="SASAN" FontWeight="Black" FontSize="18" Foreground="#FFFFFF" />
                            <TextBlock Text=" THE GADGET LOUNGE" FontWeight="SemiBold" FontSize="18" Foreground="#00E5FF" Margin="4,0,0,0"/>
                            <Border Background="#FF9100" CornerRadius="4" Padding="6,1" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="THENI" FontSize="10" FontWeight="Bold" Foreground="#08101E"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="106/7, Karthik Mahall, Subban St, Opposite Theni, Suppan Ragavan Colony, NRT Nagar | Tel: 9080803070" 
                                   FontSize="11" Foreground="#8FA3BF" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Current Bill Meta -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#16253D" CornerRadius="6" Padding="12,6" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="BILL NO: " FontSize="12" FontWeight="Bold" Foreground="#8FA3BF"/>
                            <TextBlock Text="{Binding InvoiceNumber}" FontSize="13" FontWeight="Bold" Foreground="#00E5FF"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#16253D" CornerRadius="6" Padding="12,6">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="GST STATE: " FontSize="12" FontWeight="Bold" Foreground="#8FA3BF"/>
                            <TextBlock Text="33-TAMIL NADU" FontSize="12" FontWeight="Bold" Foreground="#A0E0A0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. KEYBOARD SHORTCUTS LEGEND BAR -->
        <Border Grid.Row="1" Background="#0C182B" BorderBrush="#1C2D4A" BorderThickness="0,0,0,1" Padding="16,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Quick Action Buttons & Format Selectors -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="QUICK KEYS:" FontSize="11" FontWeight="Bold" Foreground="#728AA8" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    
                    <Button Click="BtnNewBill_Click" Background="#182A45" BorderThickness="0" Padding="8,4" Margin="0,0,6,0" Cursor="Hand">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="[F2]" FontWeight="Bold" Foreground="#00E5FF" Margin="0,0,4,0"/>
                            <TextBlock Text="New Bill" FontSize="11" Foreground="#C8D4E6"/>
                        </StackPanel>
                    </Button>

                    <Button Click="BtnOpenIntake_Click" Background="#1B3B36" BorderThickness="1" BorderBrush="#00E5FF" Padding="8,4" Margin="0,0,6,0" Cursor="Hand">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="[F3]" FontWeight="Bold" Foreground="#00E5FF" Margin="0,0,4,0"/>
                            <TextBlock Text="🏷️ Stock &amp; Sticker Studio" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF"/>
                        </StackPanel>
                    </Button>

                    <Button Click="BtnPrintSticker_Click" Background="#182A45" BorderThickness="0" Padding="8,4" Margin="0,0,6,0" Cursor="Hand">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="[F4]" FontWeight="Bold" Foreground="#FF9100" Margin="0,0,4,0"/>
                            <TextBlock Text="Print Sticker" FontSize="11" Foreground="#C8D4E6"/>
                        </StackPanel>
                    </Button>

                    <Button Click="BtnOpenSettings_Click" Background="#241B3B" BorderThickness="1" BorderBrush="#C084FC" Padding="8,4" Margin="0,0,6,0" Cursor="Hand">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="[F5]" FontWeight="Bold" Foreground="#C084FC" Margin="0,0,4,0"/>
                            <TextBlock Text="⚙️ Store Profile" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF"/>
                        </StackPanel>
                    </Button>

                    <Button Click="BtnOpenWirelessStudio_Click" Background="#1E2A4A" BorderThickness="1" BorderBrush="#38BDF8" Padding="8,4" Margin="0,0,6,0" Cursor="Hand">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="[F6]" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,4,0"/>
                            <TextBlock Text="📡 NFC &amp; RFID" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF"/>
                        </StackPanel>
                    </Button>

                    <!-- GST Toggle Button [F7] -->
                    <Button Command="{Binding ToggleGstModeCommand}" Background="#202C3F" BorderThickness="1" BorderBrush="#FF9100" Padding="8,4" Margin="0,0,6,0" Cursor="Hand">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="[F7]" FontWeight="Bold" Foreground="#FF9100" Margin="0,0,4,0"/>
                            <TextBlock Text="GST: " FontSize="11" Foreground="#C8D4E6"/>
                            <TextBlock Text="ON" FontWeight="Black" Foreground="#00E5FF" 
                                       Visibility="{Binding IsGstEnabled, Converter={StaticResource BoolToVis}}"/>
                            <TextBlock Text="OFF (₹0 Tax)" FontWeight="Black" Foreground="#FF9100">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsGstEnabled}" Value="False">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding CheckoutAndPrintInvoiceCommand}" Background="#00E5FF" BorderThickness="0" Padding="8,4" Margin="0,0,10,0" Cursor="Hand">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="[F9]" FontWeight="Black" Foreground="#08101E" Margin="0,0,4,0"/>
                            <TextBlock Text="Save &amp; Print" FontSize="11" FontWeight="Bold" Foreground="#08101E"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Section 1 & Section 2 Selectors (UI Themes & Invoice Templates) -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- UI Theme Selector (6 Choices) -->
                    <Border Background="#16253D" CornerRadius="6" Padding="6,2" Margin="0,0,6,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🎨 Theme:" FontSize="11" FontWeight="Bold" Foreground="#00E5FF" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <ComboBox ItemsSource="{Binding AvailableThemeModes}" SelectedItem="{Binding SelectedThemeMode}" Width="150" Height="26" FontSize="11" />
                        </StackPanel>
                    </Border>

                    <!-- Invoice Template Selector (7 Choices) -->
                    <Border Background="#16253D" CornerRadius="6" Padding="6,2">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="📄 Invoice:" FontSize="11" FontWeight="Bold" Foreground="#FF9100" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <ComboBox ItemsSource="{Binding AvailableInvoiceTemplates}" SelectedItem="{Binding SelectedInvoiceTemplate}" Width="180" Height="26" FontSize="11" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 3. MAIN WORKSPACE -->
        <Grid Grid.Row="2" Margin="16,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="7*" /> <!-- Left: Barcode Scanner & Cart -->
                <ColumnDefinition Width="4*" /> <!-- Right: Billing Summary & Payment -->
            </Grid.ColumnDefinitions>

            <!-- LEFT COLUMN: SCANNER & CART -->
            <Grid Grid.Column="0" Margin="0,0,12,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /> <!-- Customer & Scanner Box -->
                    <RowDefinition Height="*" />    <!-- Cart Grid -->
                </Grid.RowDefinitions>

                <!-- Customer Selection & Barcode Scanner Input -->
                <Border Grid.Row="0" Background="#132035" BorderBrush="#223656" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Customer Selector Row -->
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Customer:" FontWeight="SemiBold" FontSize="13" Foreground="#9BB3D1" 
                                       VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding Customers}" 
                                      SelectedItem="{Binding SelectedCustomer}"
                                      DisplayMemberPath="FullName"
                                      Height="34" FontSize="13" Background="#0C182B" Foreground="#FFFFFF"/>
                        </Grid>

                        <!-- USB Barcode Scanner Input Box -->
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBox x:Name="TxtBarcode" Grid.Column="0"
                                     Text="{Binding BarcodeInput, UpdateSourceTrigger=PropertyChanged}"
                                     FontSize="16" FontWeight="SemiBold"
                                     Height="44" Padding="12,8"
                                     Background="#0A1424" Foreground="#00E5FF"
                                     BorderBrush="#00E5FF" BorderThickness="1.5"
                                     KeyDown="TxtBarcode_KeyDown"/>

                            <Button Grid.Column="1" Command="{Binding ProcessBarcodeScanCommand}"
                                    Content="ADD (SCAN)" Height="44" Margin="8,0,0,0" Padding="16,0"
                                    Background="#00E5FF" Foreground="#08101E" FontWeight="Bold" FontSize="13"/>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Cart Items Table -->
                <Border Grid.Row="1" Background="#132035" BorderBrush="#223656" BorderThickness="1" CornerRadius="8" Padding="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="CART ITEMS &amp; SERIALIZED DEVICES" FontWeight="Bold" FontSize="13" Foreground="#9BB3D1" Margin="4,0,0,8"/>

                        <ListView Grid.Row="1" ItemsSource="{Binding CartItems}" Background="Transparent" BorderThickness="0">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#182740" BorderBrush="#243859" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Item Name & Details -->
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14" Foreground="#FFFFFF" />
                                                    <!-- Margin Scheme Badge -->
                                                    <Border Background="#FF9100" CornerRadius="3" Padding="5,1" Margin="8,0,0,0"
                                                            Visibility="{Binding IsMarginScheme, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="RULE 32(5) MARGIN" FontSize="9" FontWeight="Bold" Foreground="#08101E"/>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding FormattedSpecs}" FontSize="11" Foreground="#8EA4C1" Margin="0,2,0,0"/>
                                                <TextBlock Text="{Binding HsnCode, StringFormat='HSN: {0}'}" FontSize="10" Foreground="#6C829E" Margin="0,1,0,0"/>
                                            </StackPanel>

                                            <!-- Qty & Unit Rate -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0">
                                                <TextBlock Text="{Binding Quantity, StringFormat='Qty: {0}'}" FontSize="12" Foreground="#C8D4E6" HorizontalAlignment="Right"/>
                                                <TextBlock Text="{Binding UnitPrice, StringFormat='Rate: ₹{0:N0}'}" FontSize="11" Foreground="#8EA4C1" HorizontalAlignment="Right"/>
                                            </StackPanel>

                                            <!-- Line Total -->
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="16,0">
                                                <TextBlock Text="{Binding LineTotal, StringFormat='₹{0:N2}'}" FontWeight="Black" FontSize="15" Foreground="#00E5FF" HorizontalAlignment="Right"/>
                                                <TextBlock Text="{Binding GstPercentage, StringFormat='GST: {0}%'}" FontSize="10" Foreground="#8EA4C1" HorizontalAlignment="Right"/>
                                            </StackPanel>

                                            <!-- Actions: Print Sticker & Remove -->
                                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                                                <Button Command="{Binding DataContext.PrintBarcodeLabelCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                        CommandParameter="{Binding}"
                                                        Content="🏷️" ToolTip="Print 50x25mm Barcode Sticker"
                                                        Height="30" Width="32" Margin="0,0,4,0" Background="#243859" Foreground="#FF9100"/>

                                                <Button Command="{Binding DataContext.RemoveCartItemCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                        CommandParameter="{Binding}"
                                                        Content="✕" ToolTip="Remove from cart"
                                                        Height="30" Width="32" Background="#3D1A24" Foreground="#FF5252"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>
            </Grid>

            <!-- RIGHT COLUMN: FINANCIAL SUMMARY & CHECKOUT -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /> <!-- Summary Totals Card -->
                    <RowDefinition Height="*" />    <!-- Split Payment Tender -->
                    <RowDefinition Height="Auto" /> <!-- Checkout Button -->
                </Grid.RowDefinitions>

                <!-- Tax & Financial Summary Card -->
                <Border Grid.Row="0" Background="#132035" BorderBrush="#223656" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="TAX &amp; BILL SUMMARY" FontWeight="Bold" FontSize="12" Foreground="#7A93B2" Margin="0,0,0,8"/>

                        <Grid Margin="0,2">
                            <TextBlock Text="Subtotal (Items):" FontSize="12" Foreground="#8FA3BF"/>
                            <TextBlock Text="{Binding SubTotal, StringFormat='₹{0:N2}'}" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Right"/>
                        </Grid>

                        <Grid Margin="0,2">
                            <TextBlock Text="Standard Taxable Value:" FontSize="12" Foreground="#8FA3BF"/>
                            <TextBlock Text="{Binding TotalTaxableValue, StringFormat='₹{0:N2}'}" FontSize="12" Foreground="#FFFFFF" HorizontalAlignment="Right"/>
                        </Grid>

                        <Grid Margin="0,2">
                            <TextBlock Text="CGST (9%):" FontSize="12" Foreground="#8FA3BF"/>
                            <TextBlock Text="{Binding TotalCGST, StringFormat='₹{0:N2}'}" FontSize="12" Foreground="#FFFFFF" HorizontalAlignment="Right"/>
                        </Grid>

                        <Grid Margin="0,2">
                            <TextBlock Text="SGST (9%):" FontSize="12" Foreground="#8FA3BF"/>
                            <TextBlock Text="{Binding TotalSGST, StringFormat='₹{0:N2}'}" FontSize="12" Foreground="#FFFFFF" HorizontalAlignment="Right"/>
                        </Grid>

                        <!-- Margin Scheme GST Note -->
                        <Border Background="#211812" BorderBrush="#FF9100" BorderThickness="1" CornerRadius="4" Padding="6,3" Margin="0,4"
                                Visibility="{Binding HasMarginSchemeItems, Converter={StaticResource BoolToVis}}">
                            <Grid>
                                <TextBlock Text="Rule 32(5) Margin GST:" FontSize="11" Foreground="#FFB74D"/>
                                <TextBlock Text="{Binding TotalMarginTax, StringFormat='₹{0:N2}'}" FontSize="11" FontWeight="Bold" Foreground="#FF9100" HorizontalAlignment="Right"/>
                            </Grid>
                        </Border>

                        <Separator Background="#223656" Margin="0,6"/>

                        <!-- Grand Total Display -->
                        <Border Background="#08101E" CornerRadius="6" Padding="10,8">
                            <Grid>
                                <TextBlock Text="NET PAYABLE:" FontSize="13" FontWeight="Bold" Foreground="#8FA3BF" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding GrandTotal, StringFormat='₹{0:N0}'}" FontSize="24" FontWeight="Black" Foreground="#00E5FF" HorizontalAlignment="Right"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Multi-Tender Split Payment Box -->
                <Border Grid.Row="1" Background="#132035" BorderBrush="#223656" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="PAYMENT SPLIT TENDER" FontWeight="Bold" FontSize="12" Foreground="#7A93B2" Margin="0,0,0,8"/>

                            <Grid Margin="0,2">
                                <TextBlock Text="Cash (₹):" FontSize="12" VerticalAlignment="Center" Foreground="#8FA3BF"/>
                                <TextBox Text="{Binding CashTendered, UpdateSourceTrigger=PropertyChanged}" Width="140" Height="30" HorizontalAlignment="Right" Background="#0C182B" Foreground="#FFFFFF"/>
                            </Grid>

                            <Grid Margin="0,2">
                                <TextBlock Text="UPI / QR (₹):" FontSize="12" VerticalAlignment="Center" Foreground="#8FA3BF"/>
                                <TextBox Text="{Binding UpiTendered, UpdateSourceTrigger=PropertyChanged}" Width="140" Height="30" HorizontalAlignment="Right" Background="#0C182B" Foreground="#00E5FF"/>
                            </Grid>

                            <Grid Margin="0,2">
                                <TextBlock Text="Card (POS Swipe ₹):" FontSize="12" VerticalAlignment="Center" Foreground="#8FA3BF"/>
                                <TextBox Text="{Binding CardTendered, UpdateSourceTrigger=PropertyChanged}" Width="140" Height="30" HorizontalAlignment="Right" Background="#0C182B" Foreground="#FFFFFF"/>
                            </Grid>

                            <Grid Margin="0,2">
                                <TextBlock Text="Exchange Deduction (₹):" FontSize="12" VerticalAlignment="Center" Foreground="#8FA3BF"/>
                                <TextBox Text="{Binding ExchangeTendered, UpdateSourceTrigger=PropertyChanged}" Width="140" Height="30" HorizontalAlignment="Right" Background="#0C182B" Foreground="#FF9100"/>
                            </Grid>

                            <Grid Margin="0,2">
                                <TextBlock Text="Finance / Bajaj EMI (₹):" FontSize="12" VerticalAlignment="Center" Foreground="#8FA3BF"/>
                                <TextBox Text="{Binding FinanceEmiTendered, UpdateSourceTrigger=PropertyChanged}" Width="140" Height="30" HorizontalAlignment="Right" Background="#0C182B" Foreground="#FFFFFF"/>
                            </Grid>

                            <Grid Margin="0,4">
                                <TextBlock Text="Txn Ref / Approval #:" FontSize="11" VerticalAlignment="Center" Foreground="#6C829E"/>
                                <TextBox Text="{Binding PaymentReference, UpdateSourceTrigger=PropertyChanged}" Width="140" Height="28" HorizontalAlignment="Right" Background="#0C182B" Foreground="#8FA3BF"/>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- Big Checkout Button -->
                <Button Grid.Row="2" Command="{Binding CheckoutAndPrintInvoiceCommand}"
                        Height="56" Background="#00E5FF" Foreground="#08101E"
                        FontSize="16" FontWeight="Black" Cursor="Hand">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⚡ [F9] COMPLETE &amp; PRINT INVOICE" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>

        <!-- 4. BOTTOM STATUS BAR -->
        <Border Grid.Row="3" Background="#070E1A" BorderBrush="#1C2D4A" BorderThickness="0,1,0,0" Padding="16,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" FontSize="12" Foreground="#8FA3BF" VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="DB: SQLite Offline-Ready" FontSize="11" Foreground="#4CAF50" Margin="0,0,12,0"/>
                    <TextBlock Text="Server: Sasan Terminal #1" FontSize="11" Foreground="#8FA3BF"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
