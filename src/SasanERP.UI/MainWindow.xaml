<ui:FluentWindow x:Class="SasanERP.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:vm="clr-namespace:SasanERP.UI.ViewModels"
        xmlns:views="clr-namespace:SasanERP.UI.Views"
        Title="Sasan The Gadget Lounge - Commercial Enterprise ERP, POS &amp; Inventory Suite"
        Height="760" Width="1240"
        MinHeight="540" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        WindowState="Normal"
        Background="{DynamicResource SasanPrimaryBrush}"
        Foreground="{DynamicResource SasanForegroundBrush}"
        KeyDown="Window_KeyDown">

    <ui:FluentWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- View DataTemplates for In-Place Dynamic Module Navigation -->
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PosViewModel}">
            <views:PosView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:InventoryViewModel}">
            <views:InventoryView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:InvoiceHistoryViewModel}">
            <views:InvoiceHistoryView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:InventoryIntakeViewModel}">
            <views:DeviceIntakeView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DaybookViewModel}">
            <views:DaybookView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:GstReportsViewModel}">
            <views:GstReportsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:WirelessStudioViewModel}">
            <views:WirelessStudioView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CompanySettingsViewModel}">
            <views:StoreSettingsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:GodModeViewModel}">
            <views:GodModeView />
        </DataTemplate>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.LayoutTransform>
            <ScaleTransform ScaleX="{Binding UiScale}" ScaleY="{Binding UiScale}" />
        </Grid.LayoutTransform>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Top Header Bar -->
            <RowDefinition Height="*" />    <!-- Main Shell (Left Nav Rail + Workspace) -->
            <RowDefinition Height="Auto" /> <!-- Bottom Status Bar -->
        </Grid.RowDefinitions>

        <!-- ============================================================== -->
        <!-- 1. TOP HEADER & STORE IDENTITY BAR                             -->
        <!-- ============================================================== -->
        <Border Grid.Row="0" Background="{DynamicResource SasanHeaderBgBrush}" BorderBrush="{DynamicResource SasanBorderBrush}" BorderThickness="0,0,0,1" Padding="12,6" MouseLeftButtonDown="Header_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Store Brand & Logo -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{DynamicResource SasanCardBgBrush}" BorderBrush="{DynamicResource SasanCyanAccentBrush}" BorderThickness="1.5" CornerRadius="20" Width="40" Height="40" Margin="0,0,10,0" ClipToBounds="True">
                        <Image Source="pack://application:,,,/Assets/logo.png" Width="36" Height="36" HorizontalAlignment="Center" VerticalAlignment="Center"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding StoreName}" FontWeight="Black" FontSize="16" Foreground="{DynamicResource SasanForegroundBrush}" />
                            <Border Background="{DynamicResource SasanAmberAccentBrush}" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="THENI OUTLET" FontSize="9" FontWeight="Bold" Foreground="#08101E"/>
                            </Border>
                            <Border Background="{DynamicResource SasanCardBgBrush}" CornerRadius="4" Padding="6,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="GSTIN: 33AAECS4821N1ZH" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource SasanCyanAccentBrush}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding StoreAddress}" FontSize="10" Foreground="{DynamicResource SasanSubTextBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Center Active Module Indicator -->
                <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Background="{DynamicResource SasanCardBgBrush}" BorderBrush="{DynamicResource SasanBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="14,4">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="ACTIVE MODULE: " FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SasanSubTextBrush}"/>
                            <TextBlock Text="{Binding CurrentSection}" FontSize="11" FontWeight="Black" Foreground="{DynamicResource SasanCyanAccentBrush}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Top Right Controls: Scale, Cashier, Theme, Template, Window Controls -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Screen Zoom / Scale Controls -->
                    <Border Background="{DynamicResource SasanCardBgBrush}" BorderBrush="{DynamicResource SasanBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="4,2" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🔍" FontSize="11" Margin="2,0,4,0" VerticalAlignment="Center"/>
                            <Button Command="{Binding ZoomOutCommand}" Content="-" Width="22" Height="22" Padding="0" Margin="1,0" Background="Transparent" Foreground="{DynamicResource SasanForegroundBrush}" BorderThickness="0" ToolTip="Zoom Out"/>
                            <TextBlock Text="{Binding UiScale, StringFormat='{}{0:P0}'}" FontSize="10" FontWeight="Bold" Width="36" TextAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource SasanCyanAccentBrush}"/>
                            <Button Command="{Binding ZoomInCommand}" Content="+" Width="22" Height="22" Padding="0" Margin="1,0" Background="Transparent" Foreground="{DynamicResource SasanForegroundBrush}" BorderThickness="0" ToolTip="Zoom In"/>
                            <Button Command="{Binding ResetZoomCommand}" Content="100%" Height="22" Padding="4,0" Margin="2,0,0,0" Background="{DynamicResource SasanBorderBrush}" Foreground="{DynamicResource SasanForegroundBrush}" FontSize="9" BorderThickness="0" ToolTip="Reset Scale (100%)"/>
                        </StackPanel>
                    </Border>

                    <!-- Cashier Badge -->
                    <Border Background="{DynamicResource SasanCardBgBrush}" BorderBrush="{DynamicResource SasanBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="👤 " FontSize="11"/>
                            <TextBlock Text="{Binding ActiveCashier}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource SasanForegroundBrush}"/>
                        </StackPanel>
                    </Border>

                    <!-- Theme Selector -->
                    <Border Background="{DynamicResource SasanCardBgBrush}" BorderBrush="{DynamicResource SasanBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="4,2" Margin="0,0,6,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🎨" FontSize="11" VerticalAlignment="Center" Margin="2,0,4,0"/>
                            <ComboBox ItemsSource="{Binding AvailableThemeModes}" SelectedItem="{Binding SelectedThemeMode}" Width="135" Height="24" FontSize="10" />
                        </StackPanel>
                    </Border>

                    <!-- Invoice Template Selector -->
                    <Border Background="{DynamicResource SasanCardBgBrush}" BorderBrush="{DynamicResource SasanBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="4,2" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="📄" FontSize="11" VerticalAlignment="Center" Margin="2,0,4,0"/>
                            <ComboBox ItemsSource="{Binding PosVM.AvailableInvoiceTemplates}" SelectedItem="{Binding PosVM.SelectedInvoiceTemplate}" Width="145" Height="24" FontSize="10" />
                        </StackPanel>
                    </Border>

                    <!-- WINDOW CAPTION CONTROLS (Minimize, Maximize/Restore, Close) -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Minimize Button -->
                        <Button Click="BtnMinimize_Click" Width="30" Height="26" Margin="0,0,2,0" Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="Minimize">
                            <TextBlock Text="—" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource SasanForegroundBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                        <!-- Maximize / Restore Button -->
                        <Button Click="BtnMaximize_Click" Width="30" Height="26" Margin="0,0,2,0" Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="Maximize / Restore">
                            <TextBlock Text="🗖" FontSize="12" Foreground="{DynamicResource SasanForegroundBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                        <!-- Close Button -->
                        <Button Click="BtnClose_Click" Width="30" Height="26" Background="#4A1818" BorderThickness="0" Cursor="Hand" ToolTip="Close Application">
                            <TextBlock Text="✕" FontSize="12" FontWeight="Bold" Foreground="#FF6B6B" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================================================== -->
        <!-- 2. MAIN SHELL (NAVIGATION RAIL + DYNAMIC WORKSPACE)            -->
        <!-- ============================================================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" /> <!-- Left Navigation Sidebar -->
                <ColumnDefinition Width="*" />   <!-- Dynamic Module View Workspace -->
            </Grid.ColumnDefinitions>

            <!-- LEFT NAVIGATION RAIL -->
            <Border Grid.Column="0" Background="{DynamicResource SasanNavBgBrush}" BorderBrush="{DynamicResource SasanBorderBrush}" BorderThickness="0,0,1,0" Padding="8,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />    <!-- Navigation Items -->
                        <RowDefinition Height="Auto" /> <!-- Bottom Action Buttons -->
                    </Grid.RowDefinitions>

                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- Section Title -->
                            <TextBlock Text="ERP MODULES" FontSize="10" FontWeight="Black" Foreground="{DynamicResource SasanSubTextBrush}" Margin="10,4,0,8"/>

                            <!-- Nav Item 1: Dashboard [F1] -->
                            <Button Click="BtnNavDashboard_Click" HorizontalContentAlignment="Left" Padding="12,10" Margin="0,0,0,4"
                                    BorderThickness="0" Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentSection}" Value="Dashboard">
                                                <Setter Property="Background" Value="{DynamicResource SasanCardBgBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <Grid Width="170">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📊 " FontSize="14" Margin="0,0,8,0"/>
                                        <TextBlock Text="Dashboard" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource SasanForegroundBrush}"/>
                                    </StackPanel>
                                    <TextBlock Text="[F1]" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource SasanCyanAccentBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </Button>

                            <!-- Nav Item 2: POS Billing [F2] -->
                            <Button Click="BtnNavPos_Click" HorizontalContentAlignment="Left" Padding="12,10" Margin="0,0,0,4"
                                    BorderThickness="0" Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentSection}" Value="PosBilling">
                                                <Setter Property="Background" Value="{DynamicResource SasanCardBgBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <Grid Width="170">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="⚡ " FontSize="14" Margin="0,0,8,0"/>
                                        <TextBlock Text="POS Billing" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource SasanForegroundBrush}"/>
                                    </StackPanel>
                                    <TextBlock Text="[F2]" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource SasanCyanAccentBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </Button>

                            <!-- Nav Item 3: Inventory & IMEI Registry [F3] -->
                            <Button Click="BtnNavInventory_Click" HorizontalContentAlignment="Left" Padding="12,10" Margin="0,0,0,4"
                                    BorderThickness="0" Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentSection}" Value="InventoryRegistry">
                                                <Setter Property="Background" Value="{DynamicResource SasanCardBgBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <Grid Width="170">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📦 " FontSize="14" Margin="0,0,8,0"/>
                                        <TextBlock Text="Stock Registry" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource SasanForegroundBrush}"/>
                                    </StackPanel>
                                    <TextBlock Text="[F3]" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource SasanCyanAccentBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </Button>

                            <!-- Nav Item 4: Sales Invoices & Reprint [F4] -->
                            <Button Click="BtnNavInvoices_Click" HorizontalContentAlignment="Left" Padding="12,10" Margin="0,0,0,4"
                                    BorderThickness="0" Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentSection}" Value="InvoiceHistory">
                                                <Setter Property="Background" Value="{DynamicResource SasanCardBgBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <Grid Width="170">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📑 " FontSize="14" Margin="0,0,8,0"/>
                                        <TextBlock Text="Invoices &amp; Bills" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource SasanForegroundBrush}"/>
                                    </StackPanel>
                                    <TextBlock Text="[F4]" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource SasanCyanAccentBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </Button>

                            <!-- Nav Item 5: Intake & Barcode Stickers [F5] -->
                            <Button Click="BtnNavIntake_Click" HorizontalContentAlignment="Left" Padding="12,10" Margin="0,0,0,4"
                                    BorderThickness="0" Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentSection}" Value="DeviceIntake">
                                                <Setter Property="Background" Value="{DynamicResource SasanCardBgBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <Grid Width="170">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🏷️ " FontSize="14" Margin="0,0,8,0"/>
                                        <TextBlock Text="Intake &amp; Stickers" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource SasanForegroundBrush}"/>
                                    </StackPanel>
                                    <TextBlock Text="[F5]" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource SasanAmberAccentBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </Button>

                            <!-- Nav Item 6: Daybook & Accounts [F6] -->
                            <Button Click="BtnNavDaybook_Click" HorizontalContentAlignment="Left" Padding="12,10" Margin="0,0,0,4"
                                    BorderThickness="0" Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentSection}" Value="DaybookLedger">
                                                <Setter Property="Background" Value="{DynamicResource SasanCardBgBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <Grid Width="170">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📒 " FontSize="14" Margin="0,0,8,0"/>
                                        <TextBlock Text="Daybook &amp; Ledgers" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource SasanForegroundBrush}"/>
                                    </StackPanel>
                                    <TextBlock Text="[F6]" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource SasanCyanAccentBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </Button>

                            <!-- Nav Item 7: GST & GSTR-1 Hub [F7] -->
                            <Button Click="BtnNavGstReports_Click" HorizontalContentAlignment="Left" Padding="12,10" Margin="0,0,0,4"
                                    BorderThickness="0" Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentSection}" Value="GstReports">
                                                <Setter Property="Background" Value="{DynamicResource SasanCardBgBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <Grid Width="170">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📈 " FontSize="14" Margin="0,0,8,0"/>
                                        <TextBlock Text="GST &amp; GSTR-1 Hub" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource SasanForegroundBrush}"/>
                                    </StackPanel>
                                    <TextBlock Text="[F7]" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource SasanCyanAccentBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </Button>

                            <!-- Nav Item 8: NFC & UHF RFID Wireless Hub [F8] -->
                            <Button Click="BtnNavWireless_Click" HorizontalContentAlignment="Left" Padding="12,10" Margin="0,0,0,4"
                                    BorderThickness="0" Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentSection}" Value="WirelessStudio">
                                                <Setter Property="Background" Value="{DynamicResource SasanCardBgBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <Grid Width="170">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📡 " FontSize="14" Margin="0,0,8,0"/>
                                        <TextBlock Text="NFC &amp; UHF RFID" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource SasanForegroundBrush}"/>
                                    </StackPanel>
                                    <TextBlock Text="[F8]" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource SasanCyanAccentBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </Button>

                            <!-- Nav Item 9: Store Settings & Profile [F10] -->
                            <Button Click="BtnNavSettings_Click" HorizontalContentAlignment="Left" Padding="12,10" Margin="0,0,0,4"
                                    BorderThickness="0" Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentSection}" Value="StoreSettings">
                                                <Setter Property="Background" Value="{DynamicResource SasanCardBgBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <Grid Width="170">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="⚙️ " FontSize="14" Margin="0,0,8,0"/>
                                        <TextBlock Text="Store Settings" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource SasanForegroundBrush}"/>
                                    </StackPanel>
                                    <TextBlock Text="[F10]" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource SasanAmberAccentBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </Button>

                            <!-- Nav Item 10: God Mode & Reports [F12] -->
                            <Button Click="BtnNavGodMode_Click" HorizontalContentAlignment="Left" Padding="12,10" Margin="0,0,0,4"
                                    BorderThickness="0" Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentSection}" Value="GodMode">
                                                <Setter Property="Background" Value="{DynamicResource SasanCardBgBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <Grid Width="170">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="👑 " FontSize="14" Margin="0,0,8,0"/>
                                        <TextBlock Text="God Mode &amp; BI" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource SasanAmberAccentBrush}"/>
                                    </StackPanel>
                                    <TextBlock Text="[F12]" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource SasanAmberAccentBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Bottom Quick POS Checkout Helper -->
                    <Border Grid.Row="1" Background="{DynamicResource SasanCardBgBrush}" BorderBrush="{DynamicResource SasanBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,8,0,0">
                        <StackPanel>
                            <TextBlock Text="QUICK BILLING ACTION" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource SasanSubTextBrush}" Margin="0,0,0,6"/>
                            <Button Command="{Binding PosVM.NewBillCommand}" Background="#1E3A8A" Foreground="#FFFFFF" 
                                    Height="32" FontWeight="Bold" FontSize="11" Margin="0,0,0,4" Cursor="Hand">
                                <TextBlock Text="➕ [F2] Fresh Invoice"/>
                            </Button>
                            <Button Command="{Binding PosVM.CheckoutAndPrintInvoiceCommand}" Background="{DynamicResource SasanCyanAccentBrush}" Foreground="#08101E" 
                                    Height="36" FontWeight="Black" FontSize="11" Cursor="Hand">
                                <TextBlock Text="⚡ [F9] Save &amp; Print"/>
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- DYNAMIC MODULE VIEW WORKSPACE -->
            <ContentControl Grid.Column="1" Content="{Binding CurrentViewModel}" Background="{DynamicResource SasanPrimaryBrush}"/>
        </Grid>

        <!-- ============================================================== -->
        <!-- 3. BOTTOM GLOBAL STATUS BAR                                    -->
        <!-- ============================================================== -->
        <Border Grid.Row="2" Background="{DynamicResource SasanHeaderBgBrush}" BorderBrush="{DynamicResource SasanBorderBrush}" BorderThickness="0,1,0,0" Padding="16,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{Binding GlobalStatus}" FontSize="12" Foreground="{DynamicResource SasanSubTextBrush}" VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding CurrentTimeString}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SasanForegroundBrush}" Margin="0,0,14,0"/>
                    <TextBlock Text="Standalone Offline Engine Active • Sasan Terminal #1 (Theni)" FontSize="11" Foreground="#4CAF50"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
